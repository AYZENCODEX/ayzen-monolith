# Local development defaults. Production values must come from the deployment
# secret manager; never commit real credentials here.
NODE_ENV=development
PORT=5000
MONOLITH_URL=http://127.0.0.1:8080
GATEWAY_REQUEST_TIMEOUT_MS=15000
SERVICE_REQUEST_TIMEOUT_MS=15000
# Required for production and docker compose:
# SESSION_SECRET=
# POSTGRES_PASSWORD=

# --- Phase 2: API host ---
# Hostnames treated as API-only hosts (no SPA, no module redirects). Default: api.ayzen.tech
# API_HOSTS=api.ayzen.tech
# Share the session cookie across every *.ayzen.tech host (and api.ayzen.tech):
# AYZEN_COOKIE_DOMAIN=.ayzen.tech
# Extra CORS origins. First-party https://ayzen.tech and https://*.ayzen.tech are always allowed.
# ALLOWED_ORIGINS=https://ayzen.tech
# Frontend BUILD-time: send all /api calls to the API host. Unset = same-origin /api (rollback).
# VITE_API_URL=https://api.ayzen.tech
