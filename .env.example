# Local development defaults. Production values must come from the deployment
# secret manager; never commit real credentials here.
NODE_ENV=development
PORT=5000
# Canonical public frontend origin used for absolute links generated by the API.
APP_URL=https://ayzen.tech
# W1-P3: OIDC issuer (the `iss` of every ID token and the origin of /.well-known/openid-configuration). Unset = APP_URL.
# Must be an absolute https origin; changing it invalidates every relying party's config, so do it only per
# docs/architecture/ADR-W1-P3-oidc-issuer.md. Boot logs `oidc.issuer.invalid` if it is malformed.
# AYZEN_OIDC_ISSUER=https://ayzen.tech
MONOLITH_URL=http://127.0.0.1:8080
GATEWAY_REQUEST_TIMEOUT_MS=15000
SERVICE_REQUEST_TIMEOUT_MS=15000
# Required for production and docker compose:
# SESSION_SECRET=
# POSTGRES_PASSWORD=

# --- Phase 2: API host ---
# Hostnames treated as API-only hosts (no SPA, no module redirects). Default: api.ayzen.tech
# API_HOSTS=api.ayzen.tech
# Share the session cookie across every *.ayzen.tech host (and api.ayzen.tech):
# AYZEN_COOKIE_DOMAIN=.ayzen.tech
# W1-P2 per-module credentials + sessions (default off = nothing changes; also the kill switch):
#   off    module routes 404, module tokens rejected.   dual   module sessions on; shared sessions still accepted on module hosts
#   strict module sessions on; shared sessions refused on module hosts.   See docs/operations/module-sessions-rollout.md
# MODULE_SESSIONS_MODE=off

# ── W1-P5: Clerk social login (Google / Facebook / GitHub), one Clerk application PER MODULE ──────────────
# Off unless MODULE_CLERK_ENABLED=1 AND the module's own CLERK_<MODULE>_* values below are all set (else /auth/module/clerk is 404).
# Never reuse one Clerk application, issuer or webhook secret across modules: boot logs `clerk.topology.invalid` if you do.
# MODULE_CLERK_ENABLED=1
# CLERK_SYLO_ISSUER=https://clerk.sylo.ayzen.tech            # the Clerk Frontend API origin of THAT module's application
# CLERK_SYLO_JWKS_URL=https://clerk.sylo.ayzen.tech/.well-known/jwks.json
# CLERK_SYLO_WEBHOOK_SECRET=whsec_...                        # Svix signing secret of that application's webhook endpoint
# CLERK_SYLO_AUTHORIZED_PARTIES=                             # optional extra origins allowed in the token `azp` claim
# ...repeat for RYFT, FYRA, VERVE, SKARN, WARDE, WISP, ZYNTH.
# Webhook endpoint to register in each Clerk application (events user.created, user.deleted):
#   https://api.ayzen.tech/api/webhooks/clerk/<module>
# Frontend build (publishable keys only, never secret keys):
# VITE_CLERK_SYLO_PUBLISHABLE_KEY=pk_live_...
# In dual mode: shared sessions are accepted on module hosts until this instant (ISO-8601). Unset = no deadline.
# MODULE_SESSIONS_LEGACY_UNTIL=2026-12-01T00:00:00Z
# MODULE_LOGIN_MAX_FAILURES=5
# MODULE_LOGIN_LOCK_MINUTES=15
# Extra CORS origins. First-party https://ayzen.tech and https://*.ayzen.tech are always allowed.
# ALLOWED_ORIGINS=https://ayzen.tech
# Frontend BUILD-time: send all /api calls to the API host. Unset = same-origin /api (rollback).
# VITE_API_URL=https://api.ayzen.tech

# --- Telegram bots (names only; set real values in Replit Secrets) ---
# Tokens: TELEGRAM_BOT_TOKEN (AYZENX), <KEY>_TELEGRAM_BOT_TOKEN for WARDE VERVE RYFT FYRA SYLO SKARN ZYNTH WISP, TELEGRAM_ADMIN_BOT_TOKEN
# Webhook secrets (>=16 chars): TELEGRAM_WEBHOOK_SECRET (AYZENX), TELEGRAM_<KEY>_WEBHOOK_SECRET, TELEGRAM_ADMIN_WEBHOOK_SECRET
# TELEGRAM_GATEWAY_TRANSPORT=auto        # auto (webhook in production, polling in dev) | webhook | polling
# TELEGRAM_GATEWAY_PUBLIC_URL=https://api.ayzen.tech
# TELEGRAM_DROP_PENDING_UPDATES=false
# TELEGRAM_ADMIN_OWNER_ID=               # numeric Telegram user id allowed to use the admin bot
