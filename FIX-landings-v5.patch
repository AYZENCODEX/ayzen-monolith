+.foot-bar{display:flex;flex-wrap:wrap;gap:.6rem 2rem;justify-content:space-between;border-top:1px solid var(--line);padding:22px 0 36px}
+
+/* ---------- responsive ---------- */
+@media (max-width:980px){
