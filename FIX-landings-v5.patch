+.graph-box{position:relative;border:1px solid var(--line);border-radius:4px;background:radial-gradient(70% 80% at 40% 50%,#13181a,#0c0f10);overflow:hidden}
+.graph-box canvas{width:100%;height:clamp(360px,46vw,560px);touch-action:pan-y}
+.legend{display:flex;flex-wrap:wrap;gap:.4rem 1.3rem;padding:.8rem 1rem;border-top:1px solid var(--line);font:400 .8125rem var(--mono);color:var(--bone-dim)}
+.legend span{display:inline-flex;align-items:center;gap:.5rem}
+.legend svg{width:12px;height:12px}
+
+/* ---------- unlocking doors ---------- */
+.doors{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(14px,2.4vw,32px);align-items:start}
+.door{position:relative;height:clamp(330px,34vw,400px);background:radial-gradient(60% 50% at 50% 55%,rgba(227,194,128,.28),rgba(194,154,82,.05) 60%,transparent 80%),#0a0d0e;border-radius:3px;box-shadow:inset 0 0 0 1px var(--line)}
+.door:nth-child(2){margin-top:clamp(20px,3.6vw,52px)}
+.door:nth-child(3){margin-top:clamp(40px,7.2vw,104px)}
+.leaf{position:absolute;inset:0;padding:22px 22px 20px;display:flex;flex-direction:column;background:linear-gradient(160deg,#2b3438,#1d2427 60%,#171c1e);box-shadow:inset 0 1px 0 rgba(255,255,255,.07),inset 0 0 0 1px #3a444a,0 18px 40px -18px rgba(0,0,0,.8);transform-origin:0% 50%;transition:transform .7s cubic-bezier(.2,.85,.2,1);border-radius:3px;outline:0}
+.leaf{animation:swing 8s ease-in-out infinite}
+.door:nth-child(2) .leaf{animation-delay:-2.7s}
+.door:nth-child(3) .leaf{animation-delay:-5.3s}
+.door:hover .leaf,.door:focus-within .leaf{animation-play-state:paused}
+.door.held .leaf{animation:none;transform:perspective(1200px) rotateY(-28deg)}
+@keyframes swing{0%,12%,100%{transform:perspective(1200px) rotateY(0)}38%,62%{transform:perspective(1200px) rotateY(-28deg)}88%{transform:perspective(1200px) rotateY(0)}}
+.leaf:focus-visible{outline:2px solid var(--brass-hi);outline-offset:3px}
