+.slip{position:relative;background:#fffdf6;border:1px solid #d5cdb6;padding:28px 28px 24px;box-shadow:0 1px 0 #fff inset,0 24px 40px -22px rgba(40,30,10,.45);transform:rotate(-1.3deg);max-width:440px;margin-inline:auto}
