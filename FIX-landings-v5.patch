+.em-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.9fr);gap:clamp(28px,6vw,96px);align-items:center}
+.em-points{margin:2rem 0 0;padding:0;list-style:none;display:grid;gap:1rem;max-width:32rem}
