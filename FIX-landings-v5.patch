+.door h3{margin:1.2rem 0 .6rem;font-size:2.2rem}
+.door p{color:var(--bone-dim);font-size:1.04rem;line-height:1.5}
+.door .hinge{position:absolute;left:0;top:10%;bottom:10%;width:6px;background:repeating-linear-gradient(180deg,var(--brass) 0 28px,transparent 28px 60px);opacity:.55}
+.rules{display:grid;grid-template-columns:1fr 1fr;gap:clamp(16px,3vw,48px);margin-top:clamp(44px,6vw,80px);padding-top:28px;border-top:1px solid var(--line)}
+.rules p{color:var(--bone-dim);max-width:30rem}
+.rules b{color:var(--bone);font-weight:500}
+
+/* ---------- emergency (paper) ---------- */
+.paper{background:var(--paper);color:#1c1a14;position:relative}
+.paper::before{content:"";position:absolute;left:0;right:0;top:-1px;height:14px;background:linear-gradient(135deg,var(--ink) 25%,transparent 25%) -14px 0/28px 14px,linear-gradient(225deg,var(--ink) 25%,transparent 25%) -14px 0/28px 14px;}
+.paper h2{color:#14120c}
