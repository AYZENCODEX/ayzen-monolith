+.sicon{display:grid;place-items:center;width:52px;height:52px;border-radius:3px;color:var(--bone);background:var(--slate);box-shadow:inset 0 0 0 1px var(--line);transition:color .2s,box-shadow .2s,transform .2s;text-decoration:none;cursor:pointer;-webkit-tap-highlight-color:transparent}
