+  for (const [name, file, edit] of mutants) {
+    const dir = mkdtempSync(join(tmpdir(), "bundles-"));
+    try {
+      cpSync(join(ROOT, AYZEN, "src"), join(dir, AYZEN, "src"), { recursive: true });
