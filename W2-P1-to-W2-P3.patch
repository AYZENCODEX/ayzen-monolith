+const ROOT = join(dirname(fileURLToPath(import.meta.url)), "..");
+const AYZEN = "artifacts/ayzen";
+const read = (root, f) => readFileSync(join(root, f), "utf8");
+const abs = (src) => (rel) => [".tsx", ".ts"].map((e) => join(src, rel + e)).find((p) => existsSync(p)) ?? null;
