// ─── GET /local-accounts/:id — fetch single account ──────────────────────────
export async function getLocalAccount(userId: number, idParam: unknown): Promise<UseCaseResult> {
  const id = parseInt(idParam as string);
  if (isNaN(id)) return { status: 400, body: { error: "Invalid ID" } };
  try {
    const result = await findLocalAccountById(id, userId);
    if (!result.rows.length) return { status: 404, body: { error: "Account not found" } };
    // Charge-on-success: only after the row was actually found — a 404 above
    // never touches the ledger. Mirrors vault.ts's GET /vault/:id pattern.
    const charge = await chargeCredits(userId, "sylo.local_account_view");
    return { status: 200, body: { ...decryptRow(result.rows[0] as any, LOCAL_SENSITIVE_FIELDS), _credits: charge.ok ? { charged: charge.charged, newBalance: charge.newBalance } : null } };
  } catch (err: any) {
    return dbError(err);
  }
}

// ─── GET /local-accounts/:id/points ──────────────────────────────────────────
export async function listLocalAccountPoints(userId: number, idParam: unknown): Promise<UseCaseResult> {
  const accountId = parseInt(idParam as string);
  if (isNaN(accountId)) return { status: 400, body: { error: "Invalid ID" } };
  try {
    const result = await selectLocalAccountPoints(accountId, userId);
    const rows = result.rows as any[];
    const total = rows.reduce((s: number, r: any) => s + Number(r.amount ?? 0), 0);
    return { status: 200, body: { entries: rows, total } };
  } catch (err: any) {
    return dbError(err);
  }
}

// ─── POST /local-accounts/:id/points ─────────────────────────────────────────
// NOTE: this route previously had NO ownership check before its INSERT; the
// requireLocalAccountOwnership gate on the route is a genuine behavior change
// from Season C (Phase C15), preserved as-is by this extraction.
export async function createLocalAccountPoint(userId: number, idParam: unknown, body: unknown): Promise<UseCaseResult> {
  const accountId = parseInt(idParam as string);
  if (isNaN(accountId)) return { status: 400, body: { error: "Invalid ID" } };
  const { amount, notes = null } = body as any;
  if (!amount || isNaN(Number(amount))) return { status: 400, body: { error: "amount required" } };
  try {
    const result = await insertLocalAccountPoint(accountId, userId, amount, notes);
    return { status: 201, body: result.rows[0] };
  } catch (err: any) {
    return dbError(err);
  }
}

