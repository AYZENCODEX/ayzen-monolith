{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && export PORT=8080 && pnpm run build && pnpm run start",
    "monolith": "pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "worker": "node --enable-source-maps --import tsx src/worker.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:mega-engine": "node --test --import tsx src/lib/mega-engine/*.test.ts",
    "test:new-engines": "node --test --import tsx src/lib/new-engines/*.test.ts",
    "test:telegram": "node --test --import tsx src/lib/telegram-command-adapter.test.ts",
    "test:projects-static": "node --test --import tsx src/projects/domain/*.test.ts src/projects/infrastructure/sql/*.test.ts src/projects/security/*.test.ts",
    "test:marketplace-db": "DATABASE_URL_TARGET=replit-test node --import tsx src/marketplace/characterization/marketplace-db-runner.mjs",
    "test:marketplace-kernel": "node --test --import tsx src/marketplace/kernel/domain/*.test.ts src/marketplace/kernel/infrastructure/*.test.ts src/marketplace/catalog/application/*.test.ts src/marketplace/analytics/application/*.test.ts src/marketplace/engagement/domain/*.test.ts src/marketplace/engagement/application/*.test.ts src/marketplace/engagement/security/*.test.ts src/marketplace/admin/domain/*.test.ts src/marketplace/admin/application/*.test.ts src/marketplace/analytics/domain/*.test.ts src/marketplace/catalog/domain/*.test.ts",
    "test:finance-static": "node --test --import tsx src/finance/domain/*.test.ts src/finance/route-security.test.ts src/finance/ledger-compat.test.ts src/finance/ai/finance-ai.test.ts src/lib/express-async-errors.test.ts src/lib/process-guards.test.ts",
    "repair:finance-wallet-journals": "node --import tsx src/finance/integrations/repair-wallet-journals.ts",
    "test:finance-db": "DATABASE_URL_TARGET=replit-test node --import tsx src/lib/finance-accounting.db-runner.mjs"
  },
  "dependencies": {
    "@ayzen/capabilities": "workspace:*",
    "@ayzen/telegram": "workspace:*",
    "@polymarket/clob-client": "^4.16.0",
    "@simplewebauthn/server": "^13.1.1",
    "@swc/helpers": "^0.5.17",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "axios": "^1.7.9",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "ethers": "^6.13.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.3.0",
    "firebase-admin": "^14.0.0",
    "helmet": "^8.1.0",
    "imap": "^0.8.19",
    "imap-simple": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^3.0.3",
    "node-telegram-bot-api": "^1.1.0",
    "nodemailer": "^9.0.1",
    "otplib": "^13.4.1",
    "pdfkit": "^0.15.1",
    "pg": "^8.22.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "zod": "catalog:",
    "qrcode": "^1.5.4",
    "resend": "^6.14.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "catalog:",
    "@types/node-cron": "^3.0.11",
    "@types/node-telegram-bot-api": "^0.64.15",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.13.4",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.6",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "4.23.1"
  }
}
