{
  "schemaVersion": 1,
  "environment": "staging",
  "data": "synthetic-only",
  "scenarios": [
    {"name": "gateway-http", "target": "api-gateway", "signal": "p95-latency", "thresholdSource": "slo-policy"},
    {"name": "event-throughput", "target": "event-bus", "signal": "consumer-lag", "thresholdSource": "slo-policy"},
    {"name": "workflow-concurrency", "target": "workflow", "signal": "active-executions", "thresholdSource": "slo-policy"},
    {"name": "telegram-burst", "target": "telegram-gateway", "signal": "update-latency", "thresholdSource": "slo-policy"},
    {"name": "database-saturation", "target": "postgres", "signal": "connections-and-latency", "thresholdSource": "provider-metrics"}
  ],
  "rules": {
    "recordObservedLimits": true,
    "noInventedReplicaCounts": true,
    "scaleSignalsMustBeMeasured": true,
    "costReviewRequired": true
  }
}