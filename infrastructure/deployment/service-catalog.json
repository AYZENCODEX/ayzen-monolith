{
  "schemaVersion": 1,
  "catalogVersion": 1,
  "repository": "ayzen",
  "defaultImage": "ghcr.io/ayzen/ayzen",
  "deployables": [
    {
      "name": "api-gateway",
      "package": "@ayzen/api-gateway",
      "source": "apps/api-gateway",
      "kind": "api",
      "owner": "platform",
      "port": 5000,
      "public": true,
      "health": "/health",
      "readiness": "/ready",
      "metrics": "/metrics",
      "rollback": "gateway-fallback",
      "dependencies": ["monolith"]
    },
    {
      "name": "monolith",
      "package": "@workspace/api-server",
      "source": "artifacts/api-server",
      "kind": "compatibility-api",
      "owner": "core",
      "port": 8080,
      "public": false,
      "health": "/health",
      "readiness": "/ready",
      "metrics": "/metrics",
      "rollback": "previous-image",
      "dependencies": ["postgres", "redis"]
    },
    {
      "name": "event-worker",
      "package": "@ayzen/worker",
      "source": "apps/worker",
      "kind": "worker",
      "owner": "platform",
      "port": 8110,
      "public": false,
      "health": "/health",
      "readiness": "/ready",
      "metrics": "/metrics",
      "rollback": "drain-and-previous-image",
      "dependencies": ["event-bus", "postgres"]
    },
    {
      "name": "telegram-gateway",
      "package": "@ayzen/telegram-gateway",
      "source": "apps/telegram-gateway",
      "kind": "telegram",
      "owner": "telegram-platform",
      "port": 8120,
      "public": true,
      "health": "/health",
      "readiness": "/ready",
      "metrics": "/metrics",
      "rollback": "pause-webhooks-and-previous-image",
      "dependencies": ["monolith", "event-bus"]
    },
    {
      "name": "identity",
      "package": "@ayzen/identity-service",
      "source": "services/identity",
      "kind": "domain-service",
      "owner": "identity",
      "port": 8100,
      "public": false,
      "health": "/health",
      "readiness": "/ready",
      "metrics": "/metrics",
      "rollback": "gateway-fallback",
      "dependencies": ["postgres"]
    },
    {
      "name": "finance",
      "package": "@ayzen/finance-service",
      "source": "services/finance",
      "kind": "domain-service",
      "owner": "ryft",
      "port": 8101,
      "public": false,
      "health": "/health",
      "readiness": "/ready",
      "metrics": "/metrics",
      "rollback": "gateway-fallback",
      "dependencies": ["postgres", "event-bus"]
    },
    {
      "name": "vault",
      "package": "@ayzen/vault-service",
      "source": "services/vault",
      "kind": "domain-service",
      "owner": "sylo",
      "port": 8102,
      "public": false,
      "health": "/health",
      "readiness": "/ready",
      "metrics": "/metrics",
      "rollback": "gateway-fallback",
      "dependencies": ["postgres", "secret-manager"]
    },
    {
      "name": "mail",
      "package": "@ayzen/mail-service",
      "source": "services/mail",
      "kind": "domain-service",
      "owner": "wisp",
      "port": 8103,
      "public": false,
      "health": "/health",
      "readiness": "/ready",
      "metrics": "/metrics",
      "rollback": "gateway-fallback",
      "dependencies": ["postgres", "mail-provider"]
    },
    {
      "name": "notification",
      "package": "@ayzen/notification-service",
      "source": "services/notification",
      "kind": "domain-service",
      "owner": "platform",
      "port": 8104,
      "public": false,
      "health": "/health",
      "readiness": "/ready",
      "metrics": "/metrics",
      "rollback": "gateway-fallback",
      "dependencies": ["postgres", "event-bus"]
    },
    {
      "name": "workflow",
      "package": "@ayzen/workflow-service",
      "source": "services/workflow",
      "kind": "domain-service",
      "owner": "skarn",
      "port": 8105,
      "public": false,
      "health": "/health",
      "readiness": "/ready",
      "metrics": "/metrics",
      "rollback": "pause-and-previous-image",
      "dependencies": ["postgres", "event-bus", "worker"]
    },
    {
      "name": "ai-agent",
      "package": "@ayzen/ai-service",
      "source": "services/ai",
      "kind": "domain-service",
      "owner": "zynth",
      "port": 8106,
      "public": false,
      "health": "/health",
      "readiness": "/ready",
      "metrics": "/metrics",
      "rollback": "disable-tools-and-previous-image",
      "dependencies": ["postgres", "event-bus"]
    },
    {
      "name": "marketplace",
      "package": "@ayzen/marketplace-service",
      "source": "services/marketplace",
      "kind": "domain-service",
      "owner": "verve",
      "port": 8107,
      "public": false,
      "health": "/health",
      "readiness": "/ready",
      "metrics": "/metrics",
      "rollback": "gateway-fallback",
      "dependencies": ["postgres"]
    },
    {
      "name": "search",
      "package": "@ayzen/search-service",
      "source": "services/search",
      "kind": "domain-service",
      "owner": "platform",
      "port": 8108,
      "public": false,
      "health": "/health",
      "readiness": "/ready",
      "metrics": "/metrics",
      "rollback": "gateway-fallback",
      "dependencies": ["postgres"]
    },
    {
      "name": "intelligence",
      "package": "@ayzen/intelligence-service",
      "source": "services/intelligence",
      "kind": "intelligence",
      "owner": "intelligence",
      "port": 8109,
      "public": false,
      "health": "/health",
      "readiness": "/ready",
      "metrics": "/metrics",
      "rollback": "pause-ingestion-and-previous-image",
      "dependencies": ["postgres", "event-bus"]
    },
    {
      "name": "admin",
      "package": "@ayzen/admin-service",
      "source": "services/admin",
      "kind": "control-plane",
      "owner": "admin",
      "port": 8111,
      "public": false,
      "health": "/health",
      "readiness": "/ready",
      "metrics": "/metrics",
      "rollback": "disable-admin-route-and-keep-application-traffic",
      "dependencies": ["postgres", "event-bus", "intelligence"]
    }
  ]
}