    "worker": {"capacity": 100, "elevatedAt": 0.7, "throttledAt": 0.9, "shedAt": 1},
    "notification": {"capacity": 500, "elevatedAt": 0.7, "throttledAt": 0.9, "shedAt": 1}
  }
}