+    flushLi();
+    parts.push(b.t === "pre" ? `<pre class="dx-diagram"${lang}>${esc(b.text)}</pre>` : `<p${lang}>${esc(b.text)}</p>`);
+  }
+  flushLi();
+  return parts.join("\n");
+}
