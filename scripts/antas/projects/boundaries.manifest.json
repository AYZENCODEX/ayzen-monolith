  "decisionsPRJ07": {
    "request": "Project owner: 'Credit charge billing gap' (team and bulk enroll were free while single enroll charged).",
    "interpretation": "Treated as confirmation that it is a gap to close.",
    "policy": "Same metered action as single enroll (workspace.project_use, currently 2 credits), charged to the acting user (the team leader for team enroll), one unit per enrollment row actually created, after the writes. The balance for the whole quantity is checked before any write (chargeCredits charges nothing when the balance is too low, so a one-unit check would let large requests through free). No refund or rollback if a concurrent spend makes the post-write charge fail, same as single enroll.",
    "assumptionsToConfirm": [
      "team enroll is charged to the leader, not the members",
      "price equals single enroll (2 credits per enrollment), with no bulk discount",
      "the bulk pre-check uses the requested count as an upper bound, so a request that would partly conflict can be refused when the balance covers only the new rows"
    ]
  }
