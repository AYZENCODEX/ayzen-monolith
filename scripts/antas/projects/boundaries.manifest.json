  "financeContract": {
    "currentUseCase": {
      "symbol": "getProjectInvestments",
      "file": "artifacts/api-server/src/finance/application/reports.ts",
      "route": "GET /finance/investments"
    },
    "equivalentToComputeProjectPnlSummary": false,
    "differences": [
      "getProjectInvestments takes only userId and returns every project; computeProjectPnlSummary takes (userId, projectId).",
      "getProjectInvestments groups by currency and converts to the user's base currency with getRateMap/toBase; computeProjectPnlSummary sums raw amounts across currencies with no conversion.",
      "getProjectInvestments also returns interestOwed; computeProjectPnlSummary does not.",
      "computeProjectPnlSummary returns roiPct; getProjectInvestments does not."
    ],
    "decision": {
      "id": "D2-prime",
      "supersedes": "D2",
      "phase": "PRJ-04",
      "summary": "Projects owns project-level ROI and P&L and public receipts end to end (domain/roi.ts, domain/pnl-receipt.ts, application/roi-receipts.ts, security/receipt-token.ts). Its single read of finance_ledger_entries is isolated in infrastructure/repositories/project-ledger-reader.ts and recorded as an accepted foreign-table edge. No Finance code changes and no Finance import from Projects.",
      "why": "The two calculations already differ on purpose or by drift (raw sums plus roiPct versus base-currency conversion plus interestOwed); the 'lockstep' comment was stale. Keeping Projects' semantics inside Projects means zero numeric drift and no dependency on Finance's WP-8/WP-9 pack. A Finance-owned per-project use case (the original D2) remains possible later, but it would change which module owns the receipt arithmetic.",
      "openQuestion": "DECIDED in PRJ-06: keep raw sums, no conversion, '$' label; pinned by tests."
    }
  },
