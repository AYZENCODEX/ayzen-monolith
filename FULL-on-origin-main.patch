+<script>
+(() => {
+  const $ = (s, r = document) => r.querySelector(s);
+  const $$ = (s, r = document) => [...r.querySelectorAll(s)];
+  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
+  const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
+  const pulse = (n, cls = "is-glow") => { n.classList.remove(cls); void n.offsetWidth; n.classList.add(cls); n.addEventListener("animationend", () => n.classList.remove(cls), { once: true }); };
+
+  /* ---- envelope address ---- */
+  const input = $("#uname"), addr = $("#addr");
+  const clean = (v) => v.toLowerCase().replace(/[^a-z0-9._-]/g, "");
+  input.addEventListener("input", () => {
+    const v = clean(input.value); if (v !== input.value) input.value = v;
+    addr.textContent = (v || "yourname") + "@ayzen.tech";
+    addr.classList.remove("press"); void addr.offsetWidth; addr.classList.add("press");
+  });
+
+  /* ---- expandable cards (glow on click) ---- */
+  $$("[data-card]").forEach((c) => c.addEventListener("click", () => {
+    c.setAttribute("aria-expanded", c.getAttribute("aria-expanded") !== "true");
+    pulse(c);
+  }));
+
+  /* ---- mini grid ---- */
+  const mini = $$("#mini .card"), detail = $("#detail");
+  mini.forEach((c) => c.addEventListener("click", () => {
+    mini.forEach((o) => o.setAttribute("aria-pressed", o === c));
+    const [t, d] = c.dataset.d.split("|");
+    detail.innerHTML = "<b></b> "; $("b", detail).textContent = t + "."; detail.append(document.createTextNode(d));
+    pulse(c);
+  }));
+
+  /* ---- rules sorter ---- */
+  const LETTERS = [
+    { f: "billing@northwind.example", s: "Receipt #2291", r: 0 },
+    { f: "mara@studio.example", s: "Re: logo files", r: -1 },
+    { f: "noreply@news.example", s: "Weekly digest, issue 48", r: 1 },
+    { f: "dad@family.example", s: "Call me when you land", r: 2 },
+    { f: "accounts@vendor.example", s: "Receipt for order 8841", r: 0 },
+  ];
+  const RULES = [
+    { when: ["subject", "contains", "receipt"], then: "Label Receipts, mark read" },
+    { when: ["subject", "contains", "digest"], then: "Move to Archive" },
+    { when: ["from", "equals", "dad@family.example"], then: "Star it" },
+  ];
+  const mailsEl = $("#mails"), rulesEl = $("#rulesList");
+  const bins = Object.fromEntries($$("[data-bin]").map((b) => [b.dataset.bin, b]));
+  RULES.forEach((r) => {
+    const d = document.createElement("div"); d.className = "rule";
+    d.innerHTML = `If <em></em> <span></span> “<em></em>”<small></small>`;
+    const [a, c] = $$("em", d); a.textContent = r.when[0]; $("span", d).textContent = r.when[1]; c.textContent = r.when[2]; $("small", d).textContent = r.then;
+    rulesEl.append(d);
+  });
+  const ruleEls = $$(".rule", rulesEl);
+  const rows = LETTERS.map((l) => {
+    const d = document.createElement("div"); d.className = "mail";
+    d.innerHTML = `<span class="s"></span><span class="chips"></span><span class="f"></span>`;
+    $(".s", d).textContent = l.s; $(".f", d).textContent = l.f; mailsEl.append(d); return d;
+  });
+  const counts = { inbox: 0, receipts: 0, archive: 0, starred: 0 };
+  const setBin = (k, d) => { counts[k] += d; $("b", bins[k]).textContent = counts[k]; if (d > 0 && !reduce) pulse(bins[k], "bump"); };
+  const chip = (row, cls, t) => { const c = document.createElement("span"); c.className = "chip " + cls; c.textContent = t; $(".chips", row).append(c); };
+  const reset = () => { rows.forEach((r) => { r.className = "mail"; $(".chips", r).innerHTML = ""; }); ruleEls.forEach((e) => e.classList.remove("hit")); Object.keys(counts).forEach((k) => { counts[k] = 0; $("b", bins[k]).textContent = 0; }); };
+  const apply = (i) => {
+    const row = rows[i], l = LETTERS[i];
+    if (l.r === 0) { chip(row, "lab", "Receipts"); chip(row, "", "read"); setBin("receipts", 1); setBin("inbox", 1); }
+    else if (l.r === 1) { chip(row, "mv", "Archive"); row.classList.add("gone"); setBin("archive", 1); }
+    else if (l.r === 2) { chip(row, "st", "★"); setBin("starred", 1); setBin("inbox", 1); }
+    else setBin("inbox", 1);
+  };
+  let playing = !reduce, visible = false, gen = 0;
+  const playBtn = $("#flowPlay");
+  async function loop(my) {
+    const waitPlay = async () => { while ((!playing || !visible) && my === gen) await sleep(150); };
+    while (my === gen) {
+      reset();
+      for (let i = 0; i < LETTERS.length && my === gen; i++) {
+        await waitPlay(); if (my !== gen) return;
+        rows[i].classList.add("on");
+        const r = LETTERS[i].r; if (r >= 0) ruleEls[r].classList.add("hit");
+        await sleep(900); apply(i); await sleep(700);
+        rows[i].classList.remove("on"); if (r >= 0) ruleEls[r].classList.remove("hit");
+      }
+      await sleep(2600);
+    }
+  }
+  if (reduce) { LETTERS.forEach((_, i) => apply(i)); playBtn.hidden = true; }
+  else { loop(++gen); }
+  new IntersectionObserver((e) => { visible = e[0].isIntersecting; }, { threshold: 0.25 }).observe($("#sorter"));
+  playBtn.addEventListener("click", () => { playing = !playing; playBtn.textContent = playing ? "Pause" : "Play"; playBtn.setAttribute("aria-pressed", !playing); });
+
+  /* ---- undo send ---- */
+  let win = 10, tick = 0, endAt = 0;
+  const seg = $$(".seg button"), toast = $("#toast"), txt = $("#toastTxt"), bar = $("#bar"), sendBtn = $("#sendBtn");
+  seg.forEach((b) => b.addEventListener("click", () => { win = +b.dataset.s; seg.forEach((o) => o.setAttribute("aria-pressed", o === b)); }));
+  const done = (msg, undo) => { clearInterval(tick); tick = 0; bar.style.transition = "none"; $("#undoBtn").hidden = !undo; txt.textContent = msg; sendBtn.disabled = false; };
+  sendBtn.addEventListener("click", () => {
+    sendBtn.disabled = true; toast.classList.add("show"); $("#undoBtn").hidden = false;
+    endAt = Date.now() + win * 1000;
+    bar.style.transition = "none"; bar.style.transform = "scaleX(1)"; void bar.offsetWidth;
+    if (!reduce) { bar.style.transition = `transform ${win}s linear`; bar.style.transform = "scaleX(0)"; }
+    const upd = () => { const left = Math.ceil((endAt - Date.now()) / 1000); if (left <= 0) done("Sent to mara@studio.example.", false); else txt.textContent = `Sending in ${left}s…`; };
+    upd(); tick = setInterval(upd, 250);
+  });
+  $("#undoBtn").addEventListener("click", () => done("Stopped. The message is back in Drafts.", false));
+
+  /* ---- sending health ---- */
+  const gauge = $("#gauge"), st = $("#statusTxt"), msg = $("#gmsg"), mB = $("i", $("#mBounce")), mS = $("i", $("#mSpam"));
+  let bad = false, paused = false;
+  const say = (s, m) => { st.textContent = s; msg.textContent = m; };
+  $("#hBad").addEventListener("click", () => {
+    bad = true; paused = true; mB.style.width = "82%"; mS.style.width = "24%"; $("#mBounce").classList.add("bad"); gauge.classList.add("paused");
+    say("Sending paused", "Most of that batch bounced, so Wisp stopped sending from this account.");
+  });
+  $("#hClean").addEventListener("click", () => {
+    bad = false; mB.style.width = "5%"; mS.style.width = "3%"; $("#mBounce").classList.remove("bad");
+    msg.textContent = paused ? "Failing recipients removed. Sending stays paused until you resume it." : "Nothing was failing. Your list is already clean.";
+  });
+  $("#hResume").addEventListener("click", () => {
+    if (!paused) { msg.textContent = "Sending isn't paused."; return; }
+    if (bad) { msg.textContent = "Still above the limit. Remove the failing recipients, then try again."; return; }
+    paused = false; gauge.classList.remove("paused"); say("Sending is healthy", "Sending resumed.");
+  });
+
+  /* ---- footer links ---- */
+  /* Put the real URL in SOCIAL_LINKS. Until a value is set the icon only says so. */
+  const SOCIAL_LINKS = { x: "", telegram: "", discord: "", github: "", linkedin: "", email: "" }; // email: "mailto:you@example.com"
+  const note = $("#socialNote"); let nt = 0;
+  $$("[data-link]").forEach((a) => {
+    const url = SOCIAL_LINKS[a.dataset.link];
+    a.addEventListener("click", (e) => {
+      pulse(a);
+      if (url) return;
+      e.preventDefault(); note.textContent = a.getAttribute("aria-label") + " link isn't set yet.";
+      clearTimeout(nt); nt = setTimeout(() => (note.textContent = ""), 2800);
+    });
+    if (url) { a.href = url; if (!url.startsWith("mailto:")) { a.target = "_blank"; a.rel = "noopener noreferrer"; } }
+  });
+})();
+</script>
