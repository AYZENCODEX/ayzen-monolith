diff --git a/packages/module-registry/landings/verve/assets/js/motion.js b/packages/module-registry/landings/verve/assets/js/motion.js
new file mode 100644
index 0000000..fa8e58c
--- /dev/null
+++ b/packages/module-registry/landings/verve/assets/js/motion.js
@@ -0,0 +1,127 @@
+/*
+ * Motion background: layered silk waves drawn on a canvas.
+ * Colours come from the theme tokens (--accent, --brand), so it follows light
+ * and dark. The loop pauses off screen and in hidden tabs, and a single static
+ * frame is drawn when the visitor prefers reduced motion.
+ *
+ *   Verve.motion.mount(hostElement)
+ */
+(function () {
+  var V = window.Verve;
+  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+  /* base: vertical position, amp/amp2: wave heights as a share of the height,
+     k/k2: waves across the width, sp/sp2: speed (rad/s), c: starting colour */
+  var LAYERS = [
+    { base: 0.40, amp: 0.10, k: 0.9, sp: 0.20, ph: 0.0, amp2: 0.040, k2: 2.1, sp2: -0.14, alpha: 0.10, c: 'a' },
+    { base: 0.48, amp: 0.11, k: 1.2, sp: -0.17, ph: 1.3, amp2: 0.035, k2: 2.6, sp2: 0.20, alpha: 0.12, c: 'b' },
+    { base: 0.56, amp: 0.10, k: 1.0, sp: 0.15, ph: 2.4, amp2: 0.045, k2: 1.9, sp2: -0.11, alpha: 0.13, c: 'a' },
+    { base: 0.64, amp: 0.12, k: 1.4, sp: -0.22, ph: 3.1, amp2: 0.030, k2: 3.0, sp2: 0.16, alpha: 0.14, c: 'b' },
+    { base: 0.72, amp: 0.10, k: 0.8, sp: 0.18, ph: 4.2, amp2: 0.040, k2: 2.4, sp2: -0.19, alpha: 0.16, c: 'a' },
+    { base: 0.80, amp: 0.09, k: 1.3, sp: -0.14, ph: 5.0, amp2: 0.030, k2: 2.8, sp2: 0.13, alpha: 0.18, c: 'b' }
+  ];
+
+  function mount(host) {
+    var canvas = document.createElement('canvas');
+    host.appendChild(canvas);
+    var ctx = canvas.getContext('2d');
+    if (!ctx) return;
+
+    var w = 0, h = 0, running = false, visible = true, raf = 0;
+    var start = performance.now(), shift = 0, shiftTarget = 0;
+    var col = { a: '#b9d78f', b: '#2c5f46' };
+
+    function readColors() {
+      var cs = getComputedStyle(document.documentElement);
+      col.a = cs.getPropertyValue('--accent').trim() || col.a;
+      col.b = cs.getPropertyValue('--brand').trim() || col.b;
+    }
+
+    function draw(now) {
+      var t = (now - start) / 1000;
+      shift += (shiftTarget - shift) * 0.05;
+      ctx.clearRect(0, 0, w, h);
+      for (var i = 0; i < LAYERS.length; i++) {
+        var L = LAYERS[i];
+        var grad = ctx.createLinearGradient(0, 0, w, 0);
+        grad.addColorStop(0, col[L.c]);
+        grad.addColorStop(1, col[L.c === 'a' ? 'b' : 'a']);
+
+        ctx.beginPath();
+        for (var x = 0; x <= w + 12; x += 12) {
+          var u = x / w;
+          var y = h * L.base
+            + Math.sin(u * Math.PI * 2 * L.k + t * L.sp + L.ph + shift) * h * L.amp
+            + Math.sin(u * Math.PI * 2 * L.k2 + t * L.sp2 + shift * 0.5) * h * L.amp2;
+          if (x === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
+        }
+        ctx.globalAlpha = Math.min(1, L.alpha * 2.4);
+        ctx.lineWidth = 1.2;
+        ctx.strokeStyle = grad;
+        ctx.stroke();
+
+        ctx.lineTo(w + 12, h);
+        ctx.lineTo(0, h);
+        ctx.closePath();
+        ctx.globalAlpha = L.alpha;
+        ctx.fillStyle = grad;
+        ctx.fill();
+      }
+      ctx.globalAlpha = 1;
+    }
+
+    function loop(now) {
+      if (!running) return;
+      draw(now);
+      raf = requestAnimationFrame(loop);
+    }
+    function play() {
+      if (running || reduce.matches || !visible || document.hidden) return;
+      running = true;
+      raf = requestAnimationFrame(loop);
+    }
+    function pause() { running = false; cancelAnimationFrame(raf); }
+
+    function size() {
+      var r = host.getBoundingClientRect();
+      var dpr = Math.min(2, window.devicePixelRatio || 1);
+      w = r.width; h = r.height;
+      canvas.width = Math.max(1, Math.round(w * dpr));
+      canvas.height = Math.max(1, Math.round(h * dpr));
+      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
+      draw(performance.now());
+    }
+
+    var zone = host.parentNode;
+    if (!reduce.matches && zone) {
+      zone.addEventListener('pointermove', function (e) {
+        if (e.pointerType === 'touch') return;
+        var b = zone.getBoundingClientRect();
+        shiftTarget = (((e.clientX - b.left) / b.width) * 2 - 1) * 1.1;
+      });
+      zone.addEventListener('pointerleave', function () { shiftTarget = 0; });
+    }
+
+    if ('IntersectionObserver' in window) {
+      new IntersectionObserver(function (entries) {
+        visible = entries[0].isIntersecting;
+        if (visible) play(); else pause();
+      }).observe(host);
+    }
+    document.addEventListener('visibilitychange', function () { if (document.hidden) pause(); else play(); });
+
+    /* Follow theme changes */
+    var refresh = function () { readColors(); draw(performance.now()); };
+    if (window.MutationObserver) new MutationObserver(refresh).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
+    var dark = window.matchMedia('(prefers-color-scheme: dark)');
+    if (dark.addEventListener) dark.addEventListener('change', refresh);
+
+    if (window.ResizeObserver) new ResizeObserver(size).observe(host); else window.addEventListener('resize', size);
+
+    readColors();
+    size();
+    play();
+  }
+
+  V.motion = { mount: mount };
+})();
diff --git a/packages/module-registry/landings/verve/assets/js/pages/category.js b/packages/module-registry/landings/verve/assets/js/pages/category.js
new file mode 100644
index 0000000..2a8b288
--- /dev/null
+++ b/packages/module-registry/landings/verve/assets/js/pages/category.js
@@ -0,0 +1,42 @@
+/* Category pages: accounts, subscriptions, games */
+(function () {
+  var V = window.Verve, $ = V.$;
+  V.layout.mount();
+
+  var cat = document.body.getAttribute('data-cat');
+  var meta = V.categories.filter(function (c) { return c.id === cat; })[0];
+
+  V.api.getPlatforms(cat).then(function (list) {
+    V.stage.mount($('#hero-stage'), {
+      core: { icon: meta.icon, label: meta.label, sub: list.length + ' ' + meta.noun, c1: meta.c1, c2: meta.c2, scale: 0.82 },
+      tiles: list.slice(0, 8).map(function (p) { return { icon: p.icon, c1: p.c1, c2: p.c2 }; })
+    });
+
+    var grid = $('#grid'), count = $('#count'), input = $('#q');
+
+    function render(query) {
+      var q = (query || '').trim().toLowerCase();
+      var shown = list.filter(function (p) {
+        return !q || (p.name + ' ' + p.tagline).toLowerCase().indexOf(q) > -1;
+      });
+      count.textContent = V.fmt.plural(shown.length, meta.noun.replace(/s$/, ''), meta.noun) + (q ? ' match' : '');
+      if (!shown.length) {
+        grid.className = '';
+        grid.innerHTML = '<div class="empty"><h2>Nothing matches "' + V.esc(query) + '"</h2><p>Try another name, or clear the search.</p>' +
+          '<button class="btn" type="button" data-clear>Clear search</button></div>';
+        return;
+      }
+      grid.className = 'card-grid';
+      grid.innerHTML = shown.map(function (p) {
+        var info = V.cardInfo(cat, p);
+        return V.pcard({ href: V.platformHref(cat, p.id), c1: p.c1, c2: p.c2, icon: p.icon, title: p.name, meta: info.meta, chip: info.chip });
+      }).join('');
+    }
+
+    input.addEventListener('input', function () { render(input.value); });
+    grid.addEventListener('click', function (e) {
+      if (e.target.closest('[data-clear]')) { input.value = ''; render(''); input.focus(); }
+    });
+    render('');
+  });
+})();
diff --git a/packages/module-registry/landings/verve/assets/js/pages/home.js b/packages/module-registry/landings/verve/assets/js/pages/home.js
new file mode 100644
index 0000000..58c23a2
--- /dev/null
+++ b/packages/module-registry/landings/verve/assets/js/pages/home.js
@@ -0,0 +1,81 @@
+/* Home: hero scene, tabbed sliders, catalogue summary */
+(function () {
+  var V = window.Verve, $ = V.$;
+  V.layout.mount();
+
+  /* Hero background */
+  V.motion.mount($('#hero-motion'));
+
+  /* Slider cards per category */
+  function cardsFor(cat) {
+    if (cat === 'p2p') {
+      var fiat = V.p2p.fiats[0];
+      return V.p2p.assets.map(function (a) {
+        return V.pcard({
+          href: 'p2p.html#' + a.id.toLowerCase() + '-buy', c1: a.c1, c2: a.c2, glyph: a.glyph,
+          title: a.id, meta: 'Buy ' + fiat.symbol + V.fmt.short(a.usd * fiat.perUsd), chip: a.name
+        });
+      });
+    }
+    return V.catalog[cat].map(function (p) {
+      var info = V.cardInfo(cat, p);
+      return V.pcard({ href: V.platformHref(cat, p.id), c1: p.c1, c2: p.c2, icon: p.icon, title: p.name, meta: info.meta, chip: info.chip });
+    });
+  }
+
+  /* Two rows, filled left to right: the first half on row 1, the rest on row 2 */
+  function slotted(cards) {
+    var half = Math.ceil(cards.length / 2);
+    return cards.map(function (h, i) {
+      return '<li class="slider__item" style="grid-row:' + (i < half ? 1 : 2) + ';grid-column:' + ((i % half) + 1) + '">' + h + '</li>';
+    }).join('');
+  }
+
+  function panelHTML(c, index) {
+    return '<section class="panel" role="tabpanel" id="panel-' + c.id + '" aria-labelledby="tab-' + c.id + '"' + (index ? ' hidden' : '') + '>' +
+      '<div class="slider" data-slider>' +
+        '<div class="slider__head">' +
+          '<div><h2 class="slider__title">' + c.title + '</h2><p class="slider__sub">' + c.blurb + '</p></div>' +
+          '<div class="slider__tools"><a class="link-more" href="' + c.href + '">View all</a>' +
+            '<div class="slider__controls">' +
+              '<button class="round-btn" type="button" data-prev aria-label="Previous">' + V.icon('left') + '</button>' +
+              '<button class="round-btn" type="button" data-next aria-label="Next">' + V.icon('right') + '</button>' +
+            '</div></div>' +
+        '</div>' +
+        '<ul class="slider__track" tabindex="0" aria-label="' + c.label + '">' +
+          slotted(cardsFor(c.id)) +
+        '</ul>' +
+        '<div class="slider__progress" aria-hidden="true"><span></span></div>' +
+      '</div></section>';
+  }
+
+  var panels = $('#panels');
+  panels.innerHTML = V.categories.map(panelHTML).join('');
+  var sliders = {};
+  V.categories.forEach(function (c) { sliders[c.id] = V.slider($('#panel-' + c.id)); });
+
+  var ids = V.categories.map(function (c) { return c.id; });
+  var tabs = V.tabs($('#tabs'), function (id) {
+    V.categories.forEach(function (c) { $('#panel-' + c.id).hidden = c.id !== id; });
+    sliders[id].update();
+    try { history.replaceState(null, '', '#' + id); } catch (e) { /* ignore */ }
+  });
+  var wanted = (location.hash || '').replace('#', '');
+  if (ids.indexOf(wanted) > -1 && wanted !== ids[0]) tabs.select(wanted);
+
+  /* Catalogue summary */
+  function fromText(c) {
+    if (c.id === 'p2p') return V.fmt.plural(V.p2p.fiats.length, 'currency', 'currencies');
+    var min = Math.min.apply(null, V.catalog[c.id].map(function (p) { return p.from; }));
+    return 'From ' + V.fmt.usd(min);
+  }
+  $('#summary').innerHTML = V.categories.map(function (c) {
+    var count = c.id === 'p2p' ? V.p2p.assets.length : V.catalog[c.id].length;
+    return '<a class="summary__row" href="' + c.href + '" data-press style="--c1:' + c.c1 + ';--c2:' + c.c2 + '">' +
+      '<span class="glyph summary__icon" aria-hidden="true">' + V.icon(c.icon) + '</span>' +
+      '<span class="summary__name"><strong>' + c.label + '</strong><small>' + c.blurb + '</small></span>' +
+      '<span class="summary__count">' + count + ' ' + c.noun + '</span>' +
+      '<span class="summary__from">' + fromText(c) + '</span>' +
+      V.icon('arrow') + '</a>';
+  }).join('');
+})();
diff --git a/packages/module-registry/landings/verve/assets/js/pages/p2p.js b/packages/module-registry/landings/verve/assets/js/pages/p2p.js
new file mode 100644
index 0000000..178ff3e
--- /dev/null
+++ b/packages/module-registry/landings/verve/assets/js/pages/p2p.js
@@ -0,0 +1,217 @@
+/* P2P exchange: side and asset selection, filters, offer list, order drawer */
+(function () {
+  var V = window.Verve, $ = V.$;
+  V.layout.mount();
+
+  var assets = V.p2p.assets, fiats = V.p2p.fiats;
+  var state = { side: 'buy', asset: 'USDT', fiat: 'BDT', payment: 'all', amount: '' };
+
+  /* Deep link: p2p.html#usdt-buy */
+  (function () {
+    var parts = (location.hash || '').replace('#', '').split('-');
+    if (parts.length !== 2) return;
+    var a = assets.filter(function (x) { return x.id.toLowerCase() === parts[0]; })[0];
+    if (a) state.asset = a.id;
+    if (parts[1] === 'buy' || parts[1] === 'sell') state.side = parts[1];
+  })();
+
+  function asset() { return assets.filter(function (a) { return a.id === state.asset; })[0]; }
+  function fiat() { return fiats.filter(function (f) { return f.id === state.fiat; })[0]; }
+  function assetDecimals(a) { return a.usd >= 10000 ? 6 : a.usd >= 1000 ? 5 : a.usd >= 100 ? 4 : 2; }
+  function money(n) { return fiat().symbol + V.fmt.int(n); }
+  function assetAmount(n, a) { return n.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: assetDecimals(a) }); }
+
+  /* Scene */
+  V.stage.mount($('#hero-stage'), {
+    core: { text: '₮', label: 'P2P', sub: 'Peer to peer', c1: '#1f7a5e', c2: '#7fd0b0', scale: 0.82 },
+    tiles: assets.slice(0, 8).map(function (a) { return { text: a.glyph, c1: a.c1, c2: a.c2 }; })
+  });
+
+  /* Controls */
+  function renderSide() {
+    V.$$('.side-toggle button').forEach(function (b) { b.setAttribute('aria-pressed', String(b.getAttribute('data-side') === state.side)); });
+  }
+  function renderAssets() {
+    $('#assets').innerHTML = assets.map(function (a) {
+      return '<button class="asset-chip" type="button" data-asset="' + a.id + '" aria-pressed="' + (a.id === state.asset) + '">' +
+        '<span class="coin" style="--c1:' + a.c1 + ';--c2:' + a.c2 + '">' + V.esc(a.glyph) + '</span>' + a.id + '</button>';
+    }).join('');
+  }
+  function renderSelects() {
+    $('#fiat').innerHTML = fiats.map(function (f) {
+      return '<option value="' + f.id + '"' + (f.id === state.fiat ? ' selected' : '') + '>' + f.id + '</option>';
+    }).join('');
+    var methods = V.p2p.payments[state.fiat];
+    $('#payment').innerHTML = '<option value="all">All payment methods</option>' + methods.map(function (m) {
+      return '<option value="' + m + '"' + (m === state.payment ? ' selected' : '') + '>' + m + '</option>';
+    }).join('');
+    $('#amount-suffix').textContent = state.fiat;
+    $('#amount-label').textContent = state.side === 'buy' ? 'I want to pay' : 'I want to receive';
+  }
+  function syncHash() {
+    try { history.replaceState(null, '', '#' + state.asset.toLowerCase() + '-' + state.side); } catch (e) { /* ignore */ }
+  }
+
+  /* Offers */
+  var current = {}, token = 0;
+
+  function skeleton() {
+    var row = '<div class="offer" aria-hidden="true"><div class="offer__who"><span class="skeleton" style="width:38px;height:38px;border-radius:12px"></span><span class="skeleton" style="width:110px"></span></div>' +
+      '<span class="skeleton" style="width:90px;height:22px"></span><span class="skeleton" style="width:130px"></span><span class="skeleton" style="width:120px"></span><span class="skeleton" style="width:84px;height:36px;border-radius:10px;justify-self:end"></span></div>';
+    $('#offers').innerHTML = row + row + row + row;
+  }
+
+  function offerHTML(o) {
+    var a = asset(), side = state.side;
+    var verb = side === 'buy' ? 'Buy' : 'Sell';
+    return '<div class="offer" role="row">' +
+      '<div class="offer__who" role="cell"><span class="avatar" style="--c1:' + o.advertiser.c1 + ';--c2:' + o.advertiser.c2 + '" aria-hidden="true">' +
+        V.esc(o.advertiser.name.charAt(0)) + '<i></i></span>' +
+        '<span class="offer__name"><strong>' + V.esc(o.advertiser.name) + '</strong><small>' + V.fmt.int(o.advertiser.orders) + ' orders, ' + o.advertiser.completion + '% completed</small></span></div>' +
+      '<div class="offer__price" role="cell">' + fiat().symbol + V.fmt.price(o.price) + ' <small>per ' + a.id + '</small></div>' +
+      '<div class="offer__cell offer__cell--limits" role="cell">' +
+        '<div><span>Available </span>' + assetAmount(o.available, a) + ' ' + a.id + '</div>' +
+        '<div><span>Limit </span>' + money(o.minFiat) + ' to ' + money(o.maxFiat) + '</div></div>' +
+      '<div class="offer__cell offer__cell--pay" role="cell"><div class="chips">' +
+        o.payments.map(function (m) { return '<span class="chip">' + V.esc(m) + '</span>'; }).join('') + '</div></div>' +
+      '<div class="offer__act" role="cell"><button class="btn btn--sm btn--' + side + '" type="button" data-offer="' + o.id + '">' + verb + ' ' + a.id + '</button></div>' +
+      '</div>';
+  }
+
+  function load() {
+    var mine = ++token;
+    skeleton();
+    $('#market-line').innerHTML = '&nbsp;';
+    return V.api.getOffers(state).then(function (res) {
+      if (mine !== token) return;
+      current = {};
+      res.offers.forEach(function (o) { current[o.id] = o; });
+      var a = res.asset, f = res.fiat;
+      $('#market-line').innerHTML = '<span>Reference price <strong>' + f.symbol + V.fmt.price(res.mid) + '</strong> per ' + a.id + '</span>' +
+        '<span><strong>' + res.offers.length + '</strong> of ' + res.total + ' offers shown</span>';
+      if (!res.offers.length) {
+        $('#offers').innerHTML = '<div class="offers__state"><h2>No offers match</h2><p>Try a different amount or payment method.</p></div>';
+        return;
+      }
+      $('#offers').innerHTML = res.offers.map(offerHTML).join('');
+    });
+  }
+
+  /* Order drawer */
+  var dlg = $('#drawer'), form = $('#order-form'), active = null, pay = null;
+
+  function openDrawer(id) {
+    var o = current[id];
+    if (!o) return;
+    active = o;
+    var a = asset(), side = state.side, verb = side === 'buy' ? 'Buy' : 'Sell';
+    pay = o.payments.indexOf(state.payment) > -1 ? state.payment : o.payments[0];
+
+    var eyebrow = $('#drawer-eyebrow');
+    eyebrow.textContent = verb + ' ' + a.id;
+    eyebrow.className = 'is-' + side;
+    $('#drawer-title').textContent = o.advertiser.name;
+    $('#facts').innerHTML =
+      '<div><dt>Price</dt><dd>' + fiat().symbol + V.fmt.price(o.price) + '</dd></div>' +
+      '<div><dt>Available</dt><dd>' + assetAmount(o.available, a) + ' ' + a.id + '</dd></div>' +
+      '<div><dt>Limit</dt><dd>' + money(o.minFiat) + ' to ' + money(o.maxFiat) + '</dd></div>' +
+      '<div><dt>Payment window</dt><dd>' + o.payWindow + '</dd></div>';
+    $('#pay-label').textContent = side === 'buy' ? 'I want to pay' : 'I want to sell';
+    $('#pay-suffix').textContent = side === 'buy' ? state.fiat : a.id;
+    $('#receive-label').textContent = 'I will receive';
+    var input = $('#order-amount');
+    input.value = side === 'buy' && state.amount ? state.amount : '';
+    $('#pay-options').innerHTML = o.payments.map(function (m) {
+      return '<button type="button" data-pay="' + m + '" aria-pressed="' + (m === pay) + '">' + V.esc(m) + '</button>';
+    }).join('');
+    var place = $('#place');
+    place.textContent = verb + ' ' + a.id;
+    place.className = 'btn btn--block btn--' + side;
+    place.disabled = false;
+    $('#form-error').textContent = '';
+    updateReceive();
+
+    if (dlg.showModal) dlg.showModal(); else dlg.setAttribute('open', '');
+    document.documentElement.style.overflow = 'hidden';
+    setTimeout(function () { input.focus(); }, 60);
+  }
+
+  function parsed() { return parseFloat(($('#order-amount').value || '').replace(/,/g, '')); }
+
+  function updateReceive() {
+    var a = asset(), v = parsed(), out = '—';
+    if (v > 0 && active) {
+      out = state.side === 'buy' ? assetAmount(v / active.price, a) + ' ' + a.id : fiat().symbol + V.fmt.price(v * active.price);
+    }
+    $('#receive-value').textContent = out;
+  }
+
+  function closeDrawer() {
+    if (dlg.close) dlg.close(); else dlg.removeAttribute('open');
+  }
+  dlg.addEventListener('close', function () { document.documentElement.style.overflow = ''; });
+  dlg.addEventListener('click', function (e) { if (e.target === dlg) closeDrawer(); });
+  $('#drawer-close').addEventListener('click', closeDrawer);
+  $('#order-amount').addEventListener('input', function () { $('#form-error').textContent = ''; updateReceive(); });
+  $('#pay-options').addEventListener('click', function (e) {
+    var b = e.target.closest('[data-pay]');
+    if (!b) return;
+    pay = b.getAttribute('data-pay');
+    V.$$('#pay-options button').forEach(function (x) { x.setAttribute('aria-pressed', String(x === b)); });
+  });
+
+  form.addEventListener('submit', function (e) {
+    e.preventDefault();
+    if (!active) return;
+    var v = parsed(), err = $('#form-error');
+    if (!(v > 0)) { err.textContent = 'Enter an amount to continue.'; return; }
+    var fiatValue = state.side === 'buy' ? v : v * active.price;
+    if (fiatValue < active.minFiat || fiatValue > active.maxFiat) {
+      err.textContent = 'The amount must be worth between ' + money(active.minFiat) + ' and ' + money(active.maxFiat) + '.';
+      return;
+    }
+    var btn = $('#place');
+    btn.disabled = true;
+    V.api.createOrder({ side: state.side, asset: state.asset, fiat: state.fiat, offer: active.id, amount: v, payment: pay }).then(function (res) {
+      closeDrawer();
+      V.toast(res.message);
+    });
+  });
+
+  /* Events */
+  $('.side-toggle').addEventListener('click', function (e) {
+    var b = e.target.closest('button');
+    if (!b || b.getAttribute('data-side') === state.side) return;
+    state.side = b.getAttribute('data-side');
+    renderSide(); renderSelects(); syncHash(); load();
+  });
+  $('#assets').addEventListener('click', function (e) {
+    var b = e.target.closest('[data-asset]');
+    if (!b || b.getAttribute('data-asset') === state.asset) return;
+    state.asset = b.getAttribute('data-asset');
+    renderAssets(); syncHash(); load();
+  });
+  $('#fiat').addEventListener('change', function () {
+    state.fiat = this.value; state.payment = 'all';
+    renderSelects(); load();
+  });
+  $('#payment').addEventListener('change', function () { state.payment = this.value; load(); });
+  var timer;
+  $('#amount').addEventListener('input', function () {
+    var el = this;
+    clearTimeout(timer);
+    timer = setTimeout(function () { state.amount = el.value.replace(/,/g, '').trim(); load(); }, 280);
+  });
+  $('#filters').addEventListener('submit', function (e) { e.preventDefault(); });
+  $('#refresh').addEventListener('click', function () {
+    var btn = this;
+    btn.classList.add('is-spinning');
+    load().then(function () { btn.classList.remove('is-spinning'); });
+  });
+  $('#offers').addEventListener('click', function (e) {
+    var b = e.target.closest('[data-offer]');
+    if (b) openDrawer(b.getAttribute('data-offer'));
+  });
+
+  renderSide(); renderAssets(); renderSelects(); load();
+})();
diff --git a/packages/module-registry/landings/verve/assets/js/pages/platform.js b/packages/module-registry/landings/verve/assets/js/pages/platform.js
new file mode 100644
index 0000000..7bbcc23
--- /dev/null
+++ b/packages/module-registry/landings/verve/assets/js/pages/platform.js
@@ -0,0 +1,123 @@
+/* Platform detail page: variant cards with selection and an order bar */
+(function () {
+  var V = window.Verve, $ = V.$;
+  V.layout.mount();
+
+  var cat = document.body.getAttribute('data-cat');
+  var pid = document.body.getAttribute('data-platform');
+  var meta = V.categories.filter(function (c) { return c.id === cat; })[0];
+
+  var HELP = {
+    accounts: [
+      ['What does each card show?', 'The age of the account, the audience size where the platform has one, and the price. Tiers run from Starter to Signature as age and audience grow.'],
+      ['What happens after I select a listing?', 'You review the order summary and continue to checkout. Checkout connects once the backend is live, so nothing is charged from this page.'],
+      ['Are these real listings?', 'No. The listings here are sample data used to design the experience.']
+    ],
+    subscriptions: [
+      ['How are plans priced?', 'Longer plans cost less per month. Each card shows the total for the term, the monthly rate and how much you save against paying month to month.'],
+      ['Which durations are available?', '1, 2, 3, 6, 9 and 12 months, for every service in the catalogue.'],
+      ['Are these live prices?', 'No. Prices are sample data. Provider terms and current prices are not checked.']
+    ],
+    games: [
+      ['What is on each card?', 'The amount you receive, the price, and the cost per 100 units so packs are easy to compare.'],
+      ['Do I need to link my game account?', 'Not in this preview. Linking an account and delivery belong to the checkout that arrives with the backend.'],
+      ['Are these live prices?', 'No. Prices are sample data and nothing here is redeemable.']
+    ]
+  };
+
+  function card(p, o) {
+    var badge = o.badge ? '<span class="vcard__badge">' + V.esc(o.badge) + '</span>' : '';
+    return '<button class="vcard" type="button" aria-pressed="false" data-id="' + o.id + '" style="--c1:' + p.c1 + ';--c2:' + p.c2 + '">' +
+      '<span class="art vcard__art" aria-hidden="true"><span class="art__orb"></span><span class="art__plate"></span>' +
+        badge + (o.big || '') + '<span class="vcard__check">' + V.icon('check') + '</span></span>' +
+      '<span class="glyph vcard__glyph" aria-hidden="true">' + V.icon(p.icon) + '</span>' +
+      '<span class="vcard__body">' +
+        '<span><span class="vcard__title">' + V.esc(o.title) + '</span><span class="vcard__ref">' + V.esc(o.ref) + '</span></span>' +
+        '<span class="vcard__stats">' + o.stats.map(function (s) {
+          return '<span class="stat"><span class="stat__k">' + V.esc(s[0]) + '</span><span class="stat__v">' + V.esc(s[1]) + '</span></span>';
+        }).join('') + '</span>' +
+        '<span class="vcard__foot"><span class="vcard__price">' + V.fmt.usd(o.price) + '</span>' +
+          '<span class="vcard__cta"><span class="vcard__cta-off">Select</span><span class="vcard__cta-on">Selected</span></span></span>' +
+      '</span></button>';
+  }
+
+  /* Normalise each category's items into card options and order summaries */
+  function describe(p, it) {
+    if (cat === 'accounts') {
+      var stats = [['Age', V.fmt.years(it.age)]];
+      if (it.audience != null) stats.push([p.audience, V.fmt.compact(it.audience)]);
+      return { id: it.id, price: it.price, badge: it.tier, title: it.tier, ref: it.ref, stats: stats,
+        summary: p.name + ' account, ' + it.tier };
+    }
+    if (cat === 'subscriptions') {
+      var label = it.months === 1 ? '1 month' : it.months + ' months';
+      return { id: it.id, price: it.total, badge: it.savePct ? 'Save ' + it.savePct + '%' : 'Monthly',
+        big: '<span class="vcard__big">' + it.months + '<small>' + (it.months === 1 ? 'month' : 'months') + '</small></span>',
+        title: label, ref: p.name,
+        stats: [['Per month', V.fmt.usd(it.perMonth)], ['You save', it.savePct ? it.savePct + '%' : 'Nothing']],
+        summary: p.name + ', ' + label };
+    }
+    var amount = V.fmt.int(it.amount);
+    var gift = !!p.gift;
+    return { id: it.id, price: it.price, badge: gift ? 'Gift credit' : 'Top-up',
+      big: '<span class="vcard__big">' + (gift ? '$' : '') + amount + '<small>' + (gift ? 'credit' : p.unit) + '</small></span>',
+      title: gift ? '$' + amount + ' credit' : amount + ' ' + p.unit, ref: p.name,
+      stats: gift ? [['Type', 'Gift credit'], ['Face value', '$' + amount]]
+        : [['Amount', amount], ['Per 100', V.fmt.usd(it.price / it.amount * 100)]],
+      summary: p.name + ', ' + (gift ? '$' + amount + ' credit' : amount + ' ' + p.unit) };
+  }
+
+  function notFound() {
+    $('#variants').className = '';
+    $('#variants').innerHTML = '<div class="empty"><h2>We could not find that platform</h2><p>It may have been renamed or removed.</p>' +
+      '<a class="btn" href="' + meta.href + '">Back to ' + meta.label + '</a></div>';
+  }
+
+  V.api.getPlatform(cat, pid).then(function (p) {
+    if (!p) { notFound(); return; }
+
+    var siblings = V.catalog[cat].filter(function (x) { return x.id !== p.id; }).slice(0, 7);
+    V.stage.mount($('#hero-stage'), {
+      core: { icon: p.icon, label: p.name, sub: meta.label, c1: p.c1, c2: p.c2, scale: 0.9 },
+      tiles: siblings.map(function (s) { return { icon: s.icon, c1: s.c1, c2: s.c2 }; })
+    });
+
+    var cards = p.items.map(function (it) { return describe(p, it); });
+    $('#variants').innerHTML = cards.map(function (o) { return card(p, o); }).join('');
+
+    /* Selection and order bar */
+    var bar = $('#orderbar'), selected = null;
+    function setSelected(id) {
+      selected = id;
+      V.$$('.vcard').forEach(function (b) { b.setAttribute('aria-pressed', String(b.getAttribute('data-id') === id)); });
+      var o = cards.filter(function (c) { return c.id === id; })[0];
+      if (o) {
+        $('#ob-title').textContent = o.summary;
+        $('#ob-price').textContent = V.fmt.usd(o.price);
+      }
+      bar.classList.toggle('is-visible', !!o);
+      document.body.classList.toggle('has-orderbar', !!o);
+    }
+    $('#variants').addEventListener('click', function (e) {
+      var b = e.target.closest('.vcard');
+      if (!b) return;
+      setSelected(b.getAttribute('data-id') === selected ? null : b.getAttribute('data-id'));
+    });
+    $('#ob-clear').addEventListener('click', function () { setSelected(null); });
+    $('#ob-continue').addEventListener('click', function () {
+      var o = cards.filter(function (c) { return c.id === selected; })[0];
+      if (!o) return;
+      var btn = this;
+      btn.disabled = true;
+      V.api.createOrder({ category: cat, platform: p.id, item: o.id, price: o.price }).then(function (res) {
+        V.toast(res.message);
+        btn.disabled = false;
+      });
+    });
+  });
+
+  /* Good to know */
+  $('#help').innerHTML = HELP[cat].map(function (h) {
+    return '<details><summary>' + h[0] + '</summary><p>' + h[1] + '</p></details>';
+  }).join('');
+})();
diff --git a/packages/module-registry/landings/verve/assets/js/stage.js b/packages/module-registry/landings/verve/assets/js/stage.js
new file mode 100644
index 0000000..3f1763a
--- /dev/null
+++ b/packages/module-registry/landings/verve/assets/js/stage.js
@@ -0,0 +1,121 @@
+/*
+ * 3D stage: a glass card with real thickness floating at the centre of an
+ * orbit of tiles. Pure CSS 3D transforms driven by one requestAnimationFrame
+ * loop, so there is no library dependency and nothing to download.
+ *
+ *   Verve.stage.mount(hostElement, {
+ *     core:  { icon | text, label, sub, c1, c2, scale },
+ *     tiles: [{ icon | text, c1, c2 }, ...]
+ *   })
+ */
+(function () {
+  var V = window.Verve;
+  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
+  var TILT = -15; /* orbit plane tilt in degrees; negative shows the ring from slightly above */
+
+  function glyphHTML(o) { return o.icon ? V.icon(o.icon) : V.esc(o.text || ''); }
+
+  function mount(host, cfg) {
+    var core = cfg.core, tiles = cfg.tiles || [];
+    var scale = core.scale || 1;
+
+    host.classList.add('stage');
