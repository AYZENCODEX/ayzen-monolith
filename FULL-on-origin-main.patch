+  /* ---------- Tabs (sliding thumb, arrow-key navigation) ---------- */
+  V.tabs = function (list, onChange) {
+    var tabs = V.$$('[role="tab"]', list);
+    var thumb = V.$('.segmented__thumb', list);
+
+    function place() {
