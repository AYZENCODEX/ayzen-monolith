@@ -0,0 +1,75 @@
+#!/usr/bin/env node
+/**
+ * scripts/smoke-oidc-endpoints.mjs — W1-P3 "Done" check, run against a LIVE deployment.
+ *
+ *   node scripts/smoke-oidc-endpoints.mjs https://api.ayzen.tech [--skip-register]
+ *
+ * 1. GET {base}/.well-known/openid-configuration  -> 200 JSON, `issuer` is a valid origin.
+ * 2. For every endpoint URL the document advertises, send the advertised method with NO credentials and NO
+ *    parameters and require that the route EXISTS: any HTTP answer except 404/405/5xx counts (a bare call is
+ *    expected to be refused with 400/401/403/302 — that is the route doing its job). 404/405 means the document
+ *    advertises something that does not resolve; 5xx means it resolves but is broken.
+ * 3. Hosts: every advertised URL must be on the issuer's origin, and the issuer must equal the host being probed
+ *    unless --issuer-differs is passed (gateway/CDN setups).
+ *
+ * Nothing is created or changed: bare requests fail validation first. `--skip-register` leaves POST /oidc/register
+ * alone anyway, because it sits behind a per-IP-per-hour limiter you may not want to spend.
+ * Exit code 0 = all resolve, 1 = a problem, 2 = usage. Install-free (Node >= 18 fetch).
+ */
+const METHODS = {
+  jwks_uri: "GET",
+  authorization_endpoint: "GET",
+  token_endpoint: "POST",
+  userinfo_endpoint: "GET",
+  end_session_endpoint: "GET",
+  introspection_endpoint: "POST",
+  revocation_endpoint: "POST",
+  registration_endpoint: "POST",
+};
+
+export async function smoke(base, { skipRegister = false, issuerDiffers = false, fetchImpl = fetch, log = () => {} } = {}) {
+  const problems = [];
+  const results = [];
+  const root = base.replace(/\/+$/, "");
+  const discoveryUrl = `${root}/.well-known/openid-configuration`;
+  let doc;
+  try {
+    const r = await fetchImpl(discoveryUrl, { redirect: "manual", headers: { accept: "application/json" } });
+    if (r.status !== 200) problems.push(`GET ${discoveryUrl} -> ${r.status} (expected 200)`);
+    else if (!/application\/json/i.test(r.headers.get("content-type") || "")) problems.push(`discovery content-type is '${r.headers.get("content-type")}', expected application/json`);
+    else doc = await r.json();
+  } catch (e) { problems.push(`GET ${discoveryUrl} failed: ${e.message}`); }
+  if (!doc) return { ok: false, problems, results };
+
+  let issuerUrl;
+  try { issuerUrl = new URL(doc.issuer); } catch { problems.push(`issuer '${doc.issuer}' is not an absolute URL`); return { ok: false, problems, results }; }
+  if (issuerUrl.protocol !== "https:" && issuerUrl.hostname !== "localhost" && issuerUrl.hostname !== "127.0.0.1") problems.push(`issuer must be https: ${doc.issuer}`);
+  if (!issuerDiffers && issuerUrl.host !== new URL(root).host) problems.push(`issuer host ${issuerUrl.host} != probed host ${new URL(root).host} (pass --issuer-differs if intended)`);
+
+  for (const [field, method] of Object.entries(METHODS)) {
+    const url = doc[field];
+    if (typeof url !== "string") { problems.push(`discovery has no '${field}'`); continue; }
+    if (!url.startsWith(doc.issuer.replace(/\/+$/, "") + "/")) problems.push(`${field} (${url}) is not under the issuer ${doc.issuer}`);
+    if (field === "registration_endpoint" && skipRegister) { results.push({ field, url, skipped: true }); continue; }
+    // Probe via the probed host, not the issuer host, so a not-yet-DNS'd issuer is still testable: path only.
+    const target = root + new URL(url).pathname;
+    try {
+      const r = await fetchImpl(target, { method, redirect: "manual", headers: method === "POST" ? { "content-type": "application/x-www-form-urlencoded" } : {}, body: method === "POST" ? "" : undefined });
+      results.push({ field, url: target, method, status: r.status });
+      log(`${method} ${target} -> ${r.status}`);
+      if (r.status === 404 || r.status === 405) problems.push(`${field}: ${method} ${target} -> ${r.status} (advertised but does not resolve)`);
+      else if (r.status >= 500) problems.push(`${field}: ${method} ${target} -> ${r.status} (resolves but errors)`);
+    } catch (e) { problems.push(`${field}: ${method} ${target} failed: ${e.message}`); }
+  }
+  return { ok: problems.length === 0, problems, results };
+}
+
+if (import.meta.url === `file://${process.argv[1]}`) {
+  const args = process.argv.slice(2);
+  const base = args.find((a) => !a.startsWith("--"));
+  if (!base) { console.error("usage: node scripts/smoke-oidc-endpoints.mjs <base-url> [--skip-register] [--issuer-differs]"); process.exit(2); }
+  const { ok, problems, results } = await smoke(base, { skipRegister: args.includes("--skip-register"), issuerDiffers: args.includes("--issuer-differs"), log: console.log });
+  for (const r of results.filter((x) => x.skipped)) console.log(`SKIP ${r.field}`);
+  if (!ok) { console.error("\nFAILED:\n" + problems.map((p) => "  - " + p).join("\n")); process.exit(1); }
+  console.log(`\nOK: discovery document and all ${results.length} advertised endpoints resolve.`);
+}
diff --git a/scripts/smoke-oidc-endpoints.test.mjs b/scripts/smoke-oidc-endpoints.test.mjs
new file mode 100644
index 0000000..c488945
--- /dev/null
+++ b/scripts/smoke-oidc-endpoints.test.mjs
@@ -0,0 +1,65 @@
+import assert from "node:assert/strict";
+import http from "node:http";
+import test from "node:test";
+import { smoke } from "./smoke-oidc-endpoints.mjs";
+
+function stub(overrides = {}, issuerOverride) {
+  const server = http.createServer((req, res) => {
+    const origin = issuerOverride ?? `http://127.0.0.1:${server.address().port}`;
+    if (req.url === "/.well-known/openid-configuration") {
+      res.setHeader("content-type", "application/json");
+      return res.end(JSON.stringify({
+        issuer: origin, jwks_uri: `${origin}/.well-known/jwks.json`, authorization_endpoint: `${origin}/oidc/authorize`,
+        token_endpoint: `${origin}/oidc/token`, userinfo_endpoint: `${origin}/oidc/userinfo`, end_session_endpoint: `${origin}/oidc/logout`,
+        introspection_endpoint: `${origin}/oidc/introspect`, revocation_endpoint: `${origin}/oidc/revoke`, registration_endpoint: `${origin}/oidc/register`,
+      }));
+    }
+    const key = `${req.method} ${req.url}`;
+    res.statusCode = overrides[key] ?? ({ "GET /.well-known/jwks.json": 200, "GET /oidc/userinfo": 401 }[key] ?? 400);
+    res.end("{}");
+  });
+  return new Promise((r) => server.listen(0, "127.0.0.1", () => r({ server, base: `http://127.0.0.1:${server.address().port}` })));
+}
+
+test("passes when every advertised endpoint answers (400/401/200 all mean 'the route exists')", async () => {
+  const { server, base } = await stub();
+  const r = await smoke(base);
+  server.close();
+  assert.deepEqual(r.problems, []);
+  assert.equal(r.results.length, 8);
+});
+
+test("fails on a 404 (advertised but missing) and on a 405 (wrong method) and on a 500", async () => {
+  const { server, base } = await stub({ "POST /oidc/revoke": 404, "POST /oidc/introspect": 405, "POST /oidc/token": 500 });
+  const r = await smoke(base);
+  server.close();
+  assert.equal(r.ok, false);
+  assert.equal(r.problems.length, 3);
+  assert.match(r.problems.join("\n"), /revocation_endpoint.*404/);
+  assert.match(r.problems.join("\n"), /introspection_endpoint.*405/);
+  assert.match(r.problems.join("\n"), /token_endpoint.*500/);
+});
+
+test("--skip-register does not call /oidc/register", async () => {
+  const seen = [];
+  const { server, base } = await stub({});
+  const r = await smoke(base, { skipRegister: true, fetchImpl: (u, o) => { seen.push(`${o?.method ?? "GET"} ${new URL(u).pathname}`); return fetch(u, o); } });
+  server.close();
+  assert.ok(r.ok);
+  assert.ok(!seen.includes("POST /oidc/register"));
+});
+
+test("flags an issuer whose host is not the probed host unless --issuer-differs", async () => {
+  const { server, base } = await stub({}, "https://id.ayzen.tech");
+  const strict = await smoke(base);
+  const lax = await smoke(base, { issuerDiffers: true });
+  server.close();
+  assert.match(strict.problems.join("\n"), /issuer host id\.ayzen\.tech != probed host/);
+  assert.deepEqual(lax.problems, []);
+});
+
+test("a down server is a clear failure, not a throw", async () => {
+  const r = await smoke("http://127.0.0.1:1");
+  assert.equal(r.ok, false);
+  assert.match(r.problems[0], /failed/);
+});
diff --git a/scripts/src/backfill-module-accounts.mjs b/scripts/src/backfill-module-accounts.mjs
new file mode 100644
index 0000000..30daaa4
--- /dev/null
+++ b/scripts/src/backfill-module-accounts.mjs
@@ -0,0 +1,42 @@
+#!/usr/bin/env node
+/**
+ * W1-P1 backfill: give every existing user a module account (+ module_uid) in each module where
+ * they already have data. DRY-RUN by default; pass --apply to write.
+ *
+ *   DATABASE_URL=... node scripts/src/backfill-module-accounts.mjs            # report only
+ *   DATABASE_URL=... node scripts/src/backfill-module-accounts.mjs --apply    # create rows
+ *   ... --module sylo --module fyra                                           # limit modules
+ *   ... --json                                                                # machine report
+ *
+ * Idempotent and deterministic (user ids ascending). Requires migration 125 (the API server also
+ * applies it at boot).
+ */
+import { createRequire } from "node:module";
+// pg is a dependency of @workspace/db, not of scripts: resolve it from there (no lockfile change).
+const pg = createRequire(new URL("../../lib/db/package.json", import.meta.url))("pg");
+import { apply, plan, formatReport, SOURCES } from "./lib/module-accounts-backfill.mjs";
+
+const args = process.argv.slice(2);
+const doApply = args.includes("--apply");
+const asJson = args.includes("--json");
+const modules = args.flatMap((a, i) => (a === "--module" ? [args[i + 1]] : []));
+for (const m of modules) if (!(m in SOURCES)) { console.error(`unknown module: ${m}`); process.exit(2); }
+
+const conn = process.env.APP_DATABASE_URL || process.env.DATABASE_URL;
+if (!conn) { console.error("no DATABASE_URL / APP_DATABASE_URL"); process.exit(2); }
+
+const client = new pg.Client({ connectionString: conn, ssl: process.env.PGSSL_DISABLE ? false : { rejectUnauthorized: false } });
+await client.connect();
+const query = (sql, params) => client.query(sql, params);
+try {
+  const opts = modules.length ? { modules } : {};
+  if (!doApply) {
+    const p = await plan(query, opts);
+    console.log(asJson ? JSON.stringify(p, null, 2) : `DRY RUN (no writes; pass --apply)\n${formatReport(p)}`);
+  } else {
+    const r = await apply(query, opts);
+    console.log(asJson ? JSON.stringify(r, null, 2) : `${formatReport(r.plan)}\n\nAPPLIED: ${JSON.stringify(r.created)}`);
+  }
+} finally {
+  await client.end();
+}
diff --git a/scripts/src/lib/module-accounts-backfill.mjs b/scripts/src/lib/module-accounts-backfill.mjs
new file mode 100644
index 0000000..47af01e
--- /dev/null
+++ b/scripts/src/lib/module-accounts-backfill.mjs
@@ -0,0 +1,140 @@
+/**
+ * W1-P1: backfill logic for module_accounts (migrations/125_module_accounts.sql).
+ *
+ * "A user has a Sylo account" is derived from data the user owns in that module. SOURCES is the
+ * single, reviewable attribution map (module -> owner columns). Every table/column below was
+ * checked against lib/db/src/schema and artifacts/api-server/src/lib/schema-migrations.ts.
+ *
+ * Zynth has no per-user table in the monolith today (ai_agent_messages is the admin agent and has
+ * no user_id), so nothing backfills it; Zynth accounts are provisioned lazily (source 'lazy') on
+ * first use once W1-P2 lands.
+ *
+ * Pure: takes a `query(sql, params) -> Promise<{rows}>` function so the CLI (pg), the tests
+ * (psql) and any future admin tool share it.
+ */
+export const SOURCES = Object.freeze({
+  sylo: [
+    { table: "vault_entries", column: "user_id" },
+    { table: "local_accounts", column: "user_id" },
+    { table: "kyc_entries", column: "user_id" },
+    { table: "game_entries", column: "user_id" },
+  ],
+  ryft: [{ table: "wallets", column: "user_id" }],
+  fyra: [{ table: "finance_ledger_entries", column: "user_id" }],
+  verve: [
+    { table: "marketplace_listings", column: "seller_id" },
+    { table: "marketplace_orders", column: "buyer_id" },
+    { table: "marketplace_orders", column: "seller_id" },
+  ],
+  skarn: [
+    { table: "user_projects", column: "user_id" },
+    { table: "project_enrollments", column: "user_id" },
+    { table: "task_submissions", column: "user_id" },
+  ],
+  warde: [{ table: "team_members", column: "user_id" }],
+  wisp: [
+    { table: "email_accounts", column: "user_id" },
+    { table: "ayzen_mail", column: "from_user_id" },
+    { table: "users", column: "id", where: "s.ayzen_email IS NOT NULL" },
+  ],
+  zynth: [],
+});
+
+const IDENT = /^[a-z_][a-z0-9_]*$/;
+const ident = (s) => {
+  if (!IDENT.test(s)) throw new Error(`unsafe identifier: ${s}`);
+  return s;
+};
+
+async function tableExists(query, table) {
+  const { rows } = await query("SELECT to_regclass($1) AS t", [`public.${ident(table)}`]);
+  return rows[0]?.t != null;
+}
+
+/** SELECT of distinct, existing user ids that own data in one source (orphans excluded). */
+function sourceUsersSql({ table, column, where }) {
+  const t = ident(table), c = ident(column);
+  return `SELECT DISTINCT s.${c}::int AS user_id FROM ${t} s JOIN users u ON u.id = s.${c}` +
+    (where ? ` WHERE ${where}` : "");
+}
+
+/**
+ * Computes the attribution without writing. Returns
+ * { modules: { [module]: { users: number[], perSource: [{table,column,users,orphans,skipped}] } } }.
+ */
+export async function discover(query, { modules = Object.keys(SOURCES) } = {}) {
+  const out = { modules: {} };
+  for (const module of modules) {
+    if (!(module in SOURCES)) throw new Error(`unknown module: ${module}`);
+    const all = new Set();
+    const perSource = [];
+    for (const src of SOURCES[module]) {
+      if (!(await tableExists(query, src.table))) {
+        perSource.push({ ...src, users: 0, orphans: 0, skipped: "table missing" });
+        continue;
+      }
+      const { rows } = await query(sourceUsersSql(src));
+      rows.forEach((r) => all.add(Number(r.user_id)));
+      const orphan = await query(
+        `SELECT count(*)::int AS n FROM ${ident(src.table)} s LEFT JOIN users u ON u.id = s.${ident(src.column)} ` +
+          `WHERE s.${ident(src.column)} IS NOT NULL AND u.id IS NULL` + (src.where ? ` AND ${src.where}` : ""),
+      );
+      perSource.push({ ...src, users: rows.length, orphans: orphan.rows[0].n });
+    }
+    out.modules[module] = { users: [...all].sort((a, b) => a - b), perSource };
+  }
+  return out;
+}
+
+/** Splits discovery into what apply() would create vs. what already exists. */
+export async function plan(query, opts) {
+  const found = await discover(query, opts);
+  const result = { modules: {} };
+  for (const [module, info] of Object.entries(found.modules)) {
+    const { rows } = await query("SELECT user_id FROM module_accounts WHERE module = $1", [module]);
+    const have = new Set(rows.map((r) => Number(r.user_id)));
+    result.modules[module] = {
+      perSource: info.perSource,
+      attributed: info.users.length,
+      alreadyProvisioned: info.users.filter((u) => have.has(u)).length,
+      toCreate: info.users.filter((u) => !have.has(u)),
+    };
+  }
+  return result;
+}
+
+/**
+ * Creates the missing module_accounts rows. Deterministic: user ids ascending, so the same
+ * data always yields the same module_uids. Idempotent: re-running creates nothing new.
+ * `query` must run inside a single session (the CLI wraps each module in BEGIN/COMMIT).
+ */
+export async function apply(query, opts) {
+  const p = await plan(query, opts);
+  const created = {};
+  for (const [module, info] of Object.entries(p.modules)) {
+    await query("BEGIN");
+    try {
+      for (const userId of info.toCreate) {
+        await query("SELECT ayzen_provision_module_account($1::int, $2, 'backfill')", [userId, module]);
+      }
+      await query("COMMIT");
+    } catch (e) {
+      await query("ROLLBACK");
+      throw e;
+    }
+    created[module] = info.toCreate.length;
+  }
+  return { plan: p, created };
+}
+
+export function formatReport(p) {
+  const lines = ["module     attributed  existing  to-create"];
+  for (const [m, i] of Object.entries(p.modules)) {
+    lines.push(`${m.padEnd(10)} ${String(i.attributed).padStart(10)}  ${String(i.alreadyProvisioned).padStart(8)}  ${String(i.toCreate.length).padStart(9)}`);
+    for (const s of i.perSource) {
+      const note = s.skipped ? ` (${s.skipped})` : s.orphans ? ` (${s.orphans} orphan rows ignored)` : "";
+      lines.push(`  - ${s.table}.${s.column}${s.where ? ` [${s.where}]` : ""}: ${s.users} users${note}`);
+    }
+  }
+  return lines.join("\n");
+}
