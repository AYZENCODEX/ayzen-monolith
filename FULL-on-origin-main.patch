+  for (const b of bad) assert.deepEqual(parseModuleClaims(b), { ok: false }, JSON.stringify(b));
+});
diff --git a/artifacts/api-server/src/lib/module-session-policy.ts b/artifacts/api-server/src/lib/module-session-policy.ts
