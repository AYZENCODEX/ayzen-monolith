diff --git a/packages/module-registry/landings/wisp/index.html b/packages/module-registry/landings/wisp/index.html
new file mode 100644
index 0000000..875e404
--- /dev/null
+++ b/packages/module-registry/landings/wisp/index.html
@@ -0,0 +1,562 @@
+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Wisp — mail at your own address</title>
+<meta name="description" content="Wisp gives you a username@ayzen.tech address, a mailbox that sorts itself with rules, and sending from your own accounts.">
+<meta name="theme-color" content="#e6eaed">
+<style>
+@font-face{font-family:"Bricolage Grotesque";font-weight:600;font-display:swap;src:url(fonts/bricolage-grotesque-latin-600-normal.woff2) format("woff2")}
+@font-face{font-family:"Bricolage Grotesque";font-weight:800;font-display:swap;src:url(fonts/bricolage-grotesque-latin-800-normal.woff2) format("woff2")}
+@font-face{font-family:"Literata";font-weight:400;font-display:swap;src:url(fonts/literata-latin-400-normal.woff2) format("woff2")}
+@font-face{font-family:"Literata";font-weight:500;font-display:swap;src:url(fonts/literata-latin-500-normal.woff2) format("woff2")}
+@font-face{font-family:"Literata";font-weight:400;font-style:italic;font-display:swap;src:url(fonts/literata-latin-400-italic.woff2) format("woff2")}
+@font-face{font-family:"Courier Prime";font-weight:400;font-display:swap;src:url(fonts/courier-prime-latin-400-normal.woff2) format("woff2")}
+@font-face{font-family:"Courier Prime";font-weight:700;font-display:swap;src:url(fonts/courier-prime-latin-700-normal.woff2) format("woff2")}
+
+:root{
+  --fog:#e6eaed; --fog2:#d9dfe4; --paper:#f6f7f4; --ink:#1a2233; --ink2:#46506a;
+  --red:#d1453b; --blue:#2b5aa6; --smoke:#9aa3b5; --night:#141b2a; --night2:#1e2740;
+  --ok:#2f8a6a;
+  --display:"Bricolage Grotesque",system-ui,sans-serif;
+  --body:"Literata",Georgia,serif;
+  --type:"Courier Prime","Courier New",monospace;
+  --edge:repeating-linear-gradient(135deg,var(--red) 0 14px,var(--paper) 14px 22px,var(--blue) 22px 36px,var(--paper) 36px 44px);
+}
+*{box-sizing:border-box;margin:0}
+html{scroll-behavior:smooth}
+body{background:var(--fog);color:var(--ink);font:400 18px/1.65 var(--body);-webkit-font-smoothing:antialiased;overflow-x:hidden}
+a{color:inherit}
+button{font:inherit;color:inherit;cursor:pointer}
+:focus-visible{outline:3px solid var(--blue);outline-offset:3px;border-radius:4px}
+.wrap{width:min(1120px,100% - 48px);margin-inline:auto}
+h1,h2,h3{font-family:var(--display);font-weight:800;letter-spacing:-.02em;line-height:1.02}
+h2{font-size:clamp(2rem,4.6vw,3.4rem);max-width:15ch}
+h3{font-size:1.25rem;letter-spacing:-.01em;line-height:1.15;font-weight:600}
+p{max-width:58ch}
+.lede{font-size:1.15rem;color:var(--ink2)}
+.t{font-family:var(--type)}
+
+/* header */
+header{position:sticky;top:0;z-index:20;background:color-mix(in srgb,var(--fog) 88%,transparent);backdrop-filter:blur(8px);border-bottom:1px solid var(--fog2)}
+header .wrap{display:flex;align-items:center;gap:28px;height:64px}
+.mark{font:800 1.55rem var(--display);letter-spacing:-.03em;text-decoration:none;display:flex;align-items:center;gap:9px}
+.mark svg{width:26px;height:26px}
+nav{display:flex;gap:22px;margin-left:auto;font-size:.95rem}
+nav a{text-decoration:none;color:var(--ink2)} nav a:hover{color:var(--ink)}
+.btn{display:inline-block;background:var(--ink);color:var(--paper);padding:11px 20px;border-radius:999px;text-decoration:none;font:600 .95rem var(--display);border:0;transition:transform .15s,background .15s}
+.btn:hover{background:#2a3550;transform:translateY(-1px)}
+.btn.ghost{background:transparent;color:var(--ink);box-shadow:inset 0 0 0 1.5px var(--ink)}
+.btn.ghost:hover{background:var(--ink);color:var(--paper)}
+
+/* hero */
+.hero{padding:72px 0 96px}
+.hero .wrap{display:grid;grid-template-columns:1.02fr 1fr;gap:56px;align-items:center}
+h1{font-size:clamp(2.7rem,6.4vw,5.2rem);margin-bottom:22px}
+.claim{margin:30px 0 10px;display:flex;flex-wrap:wrap;gap:12px;align-items:stretch}
+.field{display:flex;align-items:center;background:var(--paper);border-radius:999px;padding:0 6px 0 20px;box-shadow:inset 0 0 0 1.5px var(--smoke);min-height:52px;flex:1 1 280px;max-width:420px}
+.field:focus-within{box-shadow:inset 0 0 0 2.5px var(--blue)}
+.field input{border:0;background:none;font:400 1.05rem var(--type);color:var(--ink);width:100%;min-width:0;outline:0;padding:10px 0}
+.field span{font:400 1.05rem var(--type);color:var(--ink2);padding-right:14px;white-space:nowrap}
+.fine{font-size:.9rem;color:var(--ink2)}
+
+.stage{perspective:1300px;display:grid;place-items:center;padding:56px 0 20px}
+.env-wrap{position:relative;width:min(470px,100%);animation:arrive .9s cubic-bezier(.2,.8,.2,1) both}
+.env-sway{transform-style:preserve-3d;animation:sway 10s ease-in-out infinite alternate}
+.flip{transform-style:preserve-3d;animation:flip 9s cubic-bezier(.5,0,.2,1) infinite}
+.front{backface-visibility:hidden;-webkit-backface-visibility:hidden;position:relative}
+.back{position:absolute;inset:0;transform:rotateY(180deg);backface-visibility:hidden;-webkit-backface-visibility:hidden;padding:9px;background:var(--edge);border-radius:4px;box-shadow:0 22px 40px -18px rgba(26,34,51,.45)}
+.bface{position:relative;height:100%;background:#eceee9;border-radius:2px;perspective:700px;overflow:visible}
+.flap{position:absolute;left:0;right:0;top:0;height:62%;background:#dde2e7;clip-path:polygon(0 0,100% 0,50% 100%);transform-origin:50% 0;animation:flap 9s ease-in-out infinite;filter:drop-shadow(0 3px 2px rgba(0,0,0,.2))}
+.seal{position:absolute;left:50%;top:52%;width:44px;height:44px;margin:-22px 0 0 -22px;border-radius:50%;background:radial-gradient(circle at 35% 30%,#e9695f,var(--red) 55%,#9c2a22);display:grid;place-items:center;animation:seal 9s ease-in-out infinite;box-shadow:0 2px 4px rgba(0,0,0,.3)}
+.seal svg{width:24px;height:24px;stroke:#f6d6d2;fill:none;stroke-width:2.6;stroke-linecap:round}
+.letter{position:absolute;left:7%;right:7%;top:0;height:78%;background:var(--paper);border-radius:3px;box-shadow:0 1px 0 var(--fog2),0 6px 18px rgba(26,34,51,.14);transform:translateY(-4px);animation:peek 7s ease-in-out infinite;padding:16px 18px;overflow:hidden}
+.letter i{display:block;height:5px;background:var(--fog2);border-radius:3px;margin-bottom:9px}
+.letter i:nth-child(2){width:78%}.letter i:nth-child(3){width:54%}
+.edge{position:relative;padding:9px;background:var(--edge);border-radius:4px;box-shadow:0 22px 40px -18px rgba(26,34,51,.45),0 2px 0 rgba(26,34,51,.08)}
+.face{background:var(--paper);aspect-ratio:1.6;position:relative;border-radius:2px;padding:18px 20px}
+.ret{font:400 .8rem/1.4 var(--type);color:var(--ink2)}
+.to{position:absolute;left:38%;right:18px;bottom:22%;font:400 .8rem/1.5 var(--type);color:var(--ink2)}
+.to b{display:block;font:700 clamp(.95rem,2.8vw,1.22rem)/1.25 var(--type);color:var(--ink);overflow-wrap:anywhere;margin-top:2px}
+.to b.press{animation:press .28s ease-out}
+.stamp{position:absolute;top:16px;right:18px;width:58px;height:70px;background:var(--paper);padding:5px;
+  box-shadow:0 0 0 1px var(--smoke);outline:2px dashed var(--smoke);outline-offset:3px}
+.stamp svg{width:100%;height:100%;display:block;background:linear-gradient(160deg,#cfd8ea,#9fb2d6)}
+.postmark{position:absolute;top:2px;right:56px;width:92px;height:92px;opacity:.78;transform:rotate(-14deg);animation:thump .5s .95s cubic-bezier(.3,1.6,.5,1) both}
+.postmark svg{width:100%;height:100%}
+.waves{position:absolute;top:30px;right:10px;width:70px;height:26px}
+
+@keyframes flip{0%,38%{transform:rotateY(0)}52%,74%{transform:rotateY(180deg)}88%,100%{transform:rotateY(360deg)}}
+@keyframes flap{0%,58%{transform:rotateX(0)}64%,70%{transform:rotateX(178deg)}76%,100%{transform:rotateX(0)}}
+@keyframes seal{0%,58%{opacity:1}61%,72%{opacity:0}76%,100%{opacity:1}}
+@keyframes arrive{from{opacity:0;transform:translateX(70px) rotate(5deg)}to{opacity:1;transform:none}}
+@keyframes sway{from{transform:rotateY(-9deg) rotateX(4deg)}to{transform:rotateY(7deg) rotateX(1deg)}}
+@keyframes peek{0%,18%{transform:translateY(-4px)}46%,64%{transform:translateY(-46px)}92%,100%{transform:translateY(-4px)}}
+@keyframes thump{from{opacity:0;transform:rotate(-14deg) scale(1.9)}to{opacity:.78;transform:rotate(-14deg) scale(1)}}
+@keyframes press{0%{transform:translateY(2px);opacity:.55}100%{transform:none;opacity:1}}
+
+/* sections */
+section{padding:104px 0}
+.head{display:grid;gap:18px;margin-bottom:48px}
+.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
+.card{all:unset;box-sizing:border-box;cursor:pointer;display:block;background:var(--paper);border-radius:14px;padding:26px 26px 24px;position:relative;box-shadow:0 1px 0 var(--fog2);transition:transform .18s}
+.card:hover{transform:translateY(-3px)}
+.card:focus-visible{outline:3px solid var(--blue);outline-offset:3px}
+.card h3{margin-bottom:10px;display:flex;justify-content:space-between;gap:12px;align-items:baseline}
+.card h3::after{content:"+";font:600 1.3rem var(--display);color:var(--smoke);transition:transform .2s}
+.card[aria-expanded=true] h3::after{transform:rotate(45deg)}
+.card p{font-size:1rem;color:var(--ink2)}
+.card .more{display:none;margin-top:14px;padding-top:14px;border-top:1px dashed var(--smoke);font-size:.95rem}
+.card[aria-expanded=true] .more{display:block}
+.card.is-glow{animation:glow .7s ease-out}
+@keyframes glow{0%{box-shadow:0 0 0 0 rgba(160,165,175,.0),0 1px 0 var(--fog2)}30%{box-shadow:0 0 0 6px rgba(160,165,175,.45),0 0 34px 8px rgba(160,165,175,.55)}100%{box-shadow:0 0 0 0 rgba(160,165,175,0),0 1px 0 var(--fog2)}}
+
+/* rules demo */
+.sorter{display:grid;grid-template-columns:1.25fr 1fr .8fr;gap:18px;align-items:start}
+.pane{background:var(--paper);border-radius:14px;padding:18px}
+.pane h3{font-size:1rem;margin-bottom:12px;color:var(--ink2);font-weight:600}
+.mail{display:grid;grid-template-columns:1fr auto;gap:2px 10px;padding:10px 12px;border-radius:8px;font:400 .82rem/1.35 var(--type);transition:background .3s,opacity .5s,transform .5s}
+.mail+.mail{margin-top:4px}
+.mail .s{font-weight:700;color:var(--ink)}.mail .f{color:var(--ink2);grid-column:1}
+.mail .chips{grid-column:2;grid-row:1/3;display:flex;gap:5px;align-items:center;justify-content:flex-end;flex-wrap:wrap;max-width:130px}
+.chip{font:700 .68rem var(--type);padding:2px 7px;border-radius:999px;background:var(--fog2);color:var(--ink);animation:pop .3s ease-out}
+.chip.lab{background:#d6e2f5;color:var(--blue)}.chip.mv{background:#ece3d6;color:#7a5d2a}.chip.st{background:#f6e3a8;color:#6d5400}
+@keyframes pop{from{transform:scale(.4);opacity:0}to{transform:none;opacity:1}}
+.mail.on{background:var(--fog)}
+.mail.gone{opacity:.38}.mail.gone .s{text-decoration:line-through}
+.rule{font:400 .8rem/1.5 var(--type);padding:11px 12px;border-radius:8px;border:1.5px solid var(--fog2);transition:border-color .25s,background .25s}
+.rule+.rule{margin-top:8px}
+.rule.hit{border-color:var(--blue);background:#e8eef9}
+.rule em{font-style:normal;color:var(--blue);font-weight:700}
+.rule small{display:block;color:var(--ink2);font-size:.76rem}
+.bins{display:grid;gap:8px}
+.bin{display:flex;justify-content:space-between;font:600 .95rem var(--display);padding:12px 14px;background:var(--fog);border-radius:8px}
+.bin b{font:700 1rem var(--type);min-width:1.4em;text-align:right}
+.bin.bump{animation:glow .6s ease-out}
+.flowctl{margin-top:16px;display:flex;gap:12px;align-items:center}
+.flowctl .btn{padding:8px 16px}
+.cap{font-size:.9rem;color:var(--ink2)}
+
+/* timing */
+.timing{display:grid;grid-template-columns:1.1fr 1fr;gap:18px;align-items:start}
+.undo{background:var(--paper);border-radius:14px;padding:26px}
+.seg{display:inline-flex;background:var(--fog);border-radius:999px;padding:4px;margin:14px 0 20px}
+.seg button{border:0;background:none;padding:6px 14px;border-radius:999px;font:600 .9rem var(--type)}
+.seg button[aria-pressed=true]{background:var(--ink);color:var(--paper)}
+.compose{border:1.5px solid var(--fog2);border-radius:10px;padding:14px 16px;font:400 .9rem/1.5 var(--type);color:var(--ink2);margin-bottom:16px}
+.compose b{color:var(--ink)}
+.toast{margin-top:16px;border-radius:10px;background:var(--ink);color:var(--paper);padding:12px 16px;display:none;align-items:center;gap:14px;position:relative;overflow:hidden;font:400 .92rem var(--type)}
+.toast.show{display:flex}
+.toast .bar{position:absolute;left:0;bottom:0;height:3px;background:var(--red);width:100%;transform-origin:left}
+.toast button{margin-left:auto;background:none;border:1.5px solid var(--paper);color:var(--paper);border-radius:999px;padding:3px 14px;font:700 .85rem var(--type)}
+.stack{display:grid;gap:18px}
+
+/* health */
+.band{background:var(--night);color:var(--paper);border-radius:0}
+.band .lede,.band p{color:#b9c1d4}
+.band h2{color:var(--paper)}
+.health{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:center}
+.gauge{background:var(--night2);border-radius:16px;padding:26px}
+.status{display:flex;align-items:center;gap:10px;font:700 1.05rem var(--display);margin-bottom:22px}
+.dot{width:12px;height:12px;border-radius:50%;background:var(--ok);box-shadow:0 0 0 0 rgba(47,138,106,.6);animation:beat 2s infinite}
+.paused .dot{background:var(--red);animation:none}
+@keyframes beat{70%{box-shadow:0 0 0 10px rgba(47,138,106,0)}100%{box-shadow:0 0 0 0 rgba(47,138,106,0)}}
+.meter{margin-bottom:18px;font:400 .85rem var(--type);color:#b9c1d4}
+.meter div{height:12px;background:#0f1522;border-radius:6px;margin-top:6px;overflow:hidden}
+.meter i{display:block;height:100%;width:6%;background:var(--ok);border-radius:6px;transition:width .8s cubic-bezier(.3,.8,.3,1),background .4s}
+.meter.bad i{background:var(--red)}
+.gbtns{display:flex;flex-wrap:wrap;gap:10px;margin-top:22px}
+.gbtns .btn{background:var(--paper);color:var(--ink);padding:9px 16px}
+.gbtns .btn.go{background:var(--red);color:#fff}
+.gmsg{min-height:3.2em;margin-top:14px;font:400 .88rem/1.5 var(--type);color:#d3d9e6}
+
+/* misc grid */
+.mini{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
+.mini .card{padding:18px}
+.mini .card h3{font-size:1.02rem;margin:0}
+.mini .card h3::after{content:none}
+.mini .card[aria-pressed=true]{box-shadow:inset 0 0 0 2px var(--ink)}
+.detail{margin-top:20px;background:var(--paper);border-radius:12px;padding:18px 22px;min-height:4.2em;font-size:1rem;color:var(--ink2)}
+.detail b{color:var(--ink);font-family:var(--display)}
+
+/* cta + footer */
+.cta{padding:96px 0 120px;text-align:left}
+.cta h2{max-width:14ch;margin-bottom:26px}
+footer{background:var(--ink);color:var(--paper);position:relative}
+footer::before{content:"";display:block;height:12px;background:var(--edge)}
+footer .wrap{padding:64px 0 48px;display:grid;grid-template-columns:1.3fr 1fr;gap:40px;align-items:end}
+footer h2{color:var(--paper);font-size:clamp(2rem,5vw,3.6rem);margin-bottom:12px}
+footer p{color:#b9c1d4}
+.social{display:flex;gap:12px;flex-wrap:wrap}
