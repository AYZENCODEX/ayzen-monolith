diff --git a/packages/module-registry/landings/verve/assets/css/base.css b/packages/module-registry/landings/verve/assets/css/base.css
new file mode 100644
index 0000000..258aec5
--- /dev/null
+++ b/packages/module-registry/landings/verve/assets/css/base.css
@@ -0,0 +1,91 @@
+/* Reset and element defaults */
+*,
+*::before,
+*::after { box-sizing: border-box; }
+
+:root {
+  padding-top: env(safe-area-inset-top, 0px);
+  padding-bottom: env(safe-area-inset-bottom, 0px);
+}
+
+[hidden] { display: none !important; }
+
+html {
+  -webkit-text-size-adjust: 100%;
+  scroll-behavior: smooth;
+  scroll-padding-top: calc(var(--header-h) + 16px);
+}
+
+body {
+  margin: 0;
+  min-height: 100dvh;
+  display: flex;
+  flex-direction: column;
+  background: var(--bg);
+  color: var(--text);
+  font: 400 16px/1.55 var(--font-sans);
+  -webkit-font-smoothing: antialiased;
+  text-rendering: optimizeLegibility;
+}
+
+main { flex: 1; }
+
+h1, h2, h3, h4, p, figure { margin: 0; }
+h1, h2, h3, h4 { font-family: var(--font-display); text-wrap: balance; }
+ul, ol { margin: 0; padding: 0; list-style: none; }
+a { color: inherit; text-decoration: none; }
+button, input, select, textarea { font: inherit; color: inherit; }
+button { cursor: pointer; }
+img, svg { display: block; max-width: 100%; }
+
+:focus-visible {
+  outline: 2px solid var(--brand);
+  outline-offset: 3px;
+  border-radius: 6px;
+}
+
+/* Side gutters clear a system bar at the phone's side */
+.container {
+  width: 100%;
+  max-width: calc(var(--container) + 2 * var(--gutter));
+  margin-inline: auto;
+  padding-left: max(var(--gutter), env(safe-area-inset-left, 0px));
+  padding-right: max(var(--gutter), env(safe-area-inset-right, 0px));
+}
+
+.sr-only {
+  position: absolute !important;
+  width: 1px; height: 1px;
+  margin: -1px; padding: 0;
+  overflow: hidden;
+  clip: rect(0 0 0 0);
+  white-space: nowrap;
+  border: 0;
+}
+
+.skip-link {
+  position: absolute;
+  left: 16px; top: -60px;
+  z-index: 100;
+  padding: 10px 16px;
+  border-radius: 10px;
+  background: var(--brand);
+  color: var(--on-brand);
+  font-weight: 600;
+  transition: top .2s;
+}
+.skip-link:focus { top: calc(env(safe-area-inset-top, 0px) + 12px); }
+
+/* Smooth page-to-page transitions where the browser supports them */
+@view-transition { navigation: auto; }
+::view-transition-old(root),
+::view-transition-new(root) { animation-duration: .25s; }
+
+@media (prefers-reduced-motion: reduce) {
+  html { scroll-behavior: auto; }
+  *, *::before, *::after {
+    animation-duration: .01ms !important;
+    animation-iteration-count: 1 !important;
+    transition-duration: .01ms !important;
+  }
+}
diff --git a/packages/module-registry/landings/verve/assets/css/components.css b/packages/module-registry/landings/verve/assets/css/components.css
new file mode 100644
index 0000000..bfdc810
--- /dev/null
+++ b/packages/module-registry/landings/verve/assets/css/components.css
@@ -0,0 +1,698 @@
+/* Shared components: header, buttons, tabs, slider, photo cards, variant cards, order bar, toast, footer */
+
+/* ---------- Header ---------- */
+body::before {
+  content: "";
+  position: fixed;
+  inset: 0 0 auto;
+  height: env(safe-area-inset-top, 0px);
+  z-index: 70;
+  background: var(--bg);
+}
+
+.site-header {
+  position: sticky;
+  top: env(safe-area-inset-top, 0px);
+  z-index: 60;
+  background: color-mix(in srgb, var(--bg) 88%, transparent);
+  -webkit-backdrop-filter: saturate(1.3) blur(14px);
+  backdrop-filter: saturate(1.3) blur(14px);
+  border-bottom: 1px solid var(--line);
+}
+
+.nav {
+  position: relative;
+  display: flex;
+  align-items: center;
+  gap: 28px;
+  height: var(--header-h);
+}
+
+.brand {
+  display: inline-flex;
+  align-items: center;
+  gap: 10px;
+  font: 800 22px/1 var(--font-display);
+  letter-spacing: -0.045em;
+}
+.brand__mark {
+  width: 30px; height: 30px;
+  display: grid; place-items: center;
+  border-radius: 9px;
+  background: var(--brand);
+  color: var(--on-brand);
+  font-size: 17px;
+  box-shadow: inset 0 -7px 10px rgb(0 0 0 / .16), 0 5px 12px -5px var(--brand);
+}
+
+.nav__links { display: flex; gap: 2px; }
+.nav__link {
+  padding: 9px 14px;
+  border-radius: 10px;
+  font-size: 14px;
+  font-weight: 500;
+  color: var(--text-2);
+  transition: background .2s, color .2s;
+}
+.nav__link:hover { background: var(--surface-2); color: var(--text); }
+.nav__link[aria-current="page"] { background: var(--sunken); color: var(--text); }
+
+.nav__actions { margin-left: auto; display: flex; align-items: center; gap: 8px; }
+.nav__menu { display: none; }
+
+.icon { width: 20px; height: 20px; flex: none; }
+
+.icon-btn {
+  width: 38px; height: 38px;
+  display: inline-grid; place-items: center;
+  border-radius: 11px;
+  border: 1px solid var(--line);
+  background: var(--surface);
+  color: var(--text-2);
+  transition: color .2s, border-color .2s, transform .15s var(--ease);
+}
+.icon-btn:hover { color: var(--text); border-color: var(--line-strong); }
+.icon-btn:active { transform: scale(.93); }
+
+/* ---------- Buttons ---------- */
+.btn {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 8px;
+  height: 42px;
+  padding: 0 18px;
+  border-radius: 12px;
+  border: 1px solid var(--line-strong);
+  background: var(--surface);
+  color: var(--text);
+  font: 600 14px var(--font-sans);
+  white-space: nowrap;
+  transition: transform .2s var(--ease), box-shadow .2s, background .2s, border-color .2s;
+}
+.btn:hover { border-color: var(--text-3); box-shadow: var(--e1); }
+.btn:active { transform: translateY(1px) scale(.98); }
+.btn--primary { background: var(--brand); border-color: var(--brand); color: var(--on-brand); }
+.btn--primary:hover { background: var(--brand-hover); border-color: var(--brand-hover); box-shadow: var(--e2); }
+.btn--ghost { background: transparent; border-color: transparent; color: var(--text-2); }
+.btn--ghost:hover { background: var(--surface-2); border-color: transparent; box-shadow: none; color: var(--text); }
+.btn--sm { height: 36px; padding: 0 14px; font-size: 13px; border-radius: 10px; }
+.btn--block { width: 100%; }
+.btn--buy { background: var(--buy); border-color: var(--buy); color: var(--on-buy); }
+.btn--sell { background: var(--sell); border-color: var(--sell); color: var(--on-sell); }
+.btn--buy:hover, .btn--sell:hover { filter: brightness(1.06); box-shadow: var(--e2); }
+.btn[disabled] { opacity: .5; pointer-events: none; }
+
+.link-more {
+  font-size: 14px;
+  font-weight: 600;
+  color: var(--brand);
+  border-bottom: 1px solid transparent;
+  transition: border-color .2s;
+}
+.link-more:hover { border-color: currentColor; }
+
+/* ---------- Segmented tabs ---------- */
+.segmented {
+  position: relative;
+  display: inline-flex;
+  gap: 2px;
+  max-width: 100%;
+  padding: 4px;
+  border-radius: 14px;
+  background: var(--sunken);
+  overflow-x: auto;
+  scrollbar-width: none;
+}
+.segmented::-webkit-scrollbar { display: none; }
+.segmented__thumb {
+  position: absolute;
+  top: 4px; bottom: 4px; left: 0;
+  width: 0;
+  border-radius: 10px;
+  background: var(--surface);
+  box-shadow: var(--e1);
+  pointer-events: none;
+}
+.segmented.is-ready .segmented__thumb { transition: transform .38s var(--ease), width .38s var(--ease); }
+.segmented__btn {
+  position: relative;
+  z-index: 1;
+  padding: 11px 20px;
+  border: 0;
+  border-radius: 10px;
+  background: none;
+  color: var(--text-2);
+  font: 600 14px var(--font-sans);
+  white-space: nowrap;
+  transition: color .2s;
+}
+.segmented__btn:hover { color: var(--text); }
+.segmented__btn[aria-selected="true"] { color: var(--brand); }
+
+/* ---------- Slider ---------- */
+.slider__head {
+  display: flex;
+  align-items: flex-end;
+  justify-content: space-between;
+  gap: 16px;
+  margin-bottom: 14px;
+}
+.slider__title { font: 700 22px/1.2 var(--font-display); letter-spacing: -0.03em; }
+.slider__sub { margin-top: 4px; font-size: 14px; color: var(--text-3); }
+.slider__tools { display: flex; align-items: center; gap: 18px; flex: none; }
+.slider__controls { display: flex; gap: 8px; }
+
+.round-btn {
+  width: 40px; height: 40px;
+  display: grid; place-items: center;
+  border-radius: 50%;
+  border: 1px solid var(--line-strong);
+  background: var(--surface);
+  color: var(--text);
+  transition: transform .15s var(--ease), background .2s, opacity .2s, box-shadow .2s;
+}
+.round-btn:hover { box-shadow: var(--e2); }
+.round-btn:active { transform: scale(.92); }
+.round-btn:disabled { opacity: .35; pointer-events: none; }
+
+.slider__track {
+  --cols: 6;
+  --gap: 16px;
+  /* Two rows, six columns visible: twelve cards fit; narrower screens scroll sideways */
+  display: grid;
+  grid-template-rows: repeat(2, auto);
+  grid-auto-flow: column;
+  grid-auto-columns: calc((100% - (var(--cols) - 1) * var(--gap)) / var(--cols));
+  gap: var(--gap);
+  margin: 0 -6px;
+  padding: 10px 6px 30px;
+  overflow-x: auto;
+  scroll-snap-type: x proximity;
+  scroll-padding-inline: 6px;
+  overscroll-behavior-x: contain;
+  scrollbar-width: none;
+  cursor: grab;
+}
+.slider__track::-webkit-scrollbar { display: none; }
+.slider__track.is-dragging { scroll-snap-type: none; cursor: grabbing; user-select: none; }
+.slider__item { min-width: 0; scroll-snap-align: start; }
+.slider__item .pcard { aspect-ratio: 6 / 7; }
+.slider__item .pcard__text strong { font-size: 14px; }
+.slider__item .pcard__glyph { top: 17%; }
+.slider__progress {
+  height: 3px;
+  margin-top: -10px;
+  border-radius: 3px;
+  background: var(--sunken);
+  overflow: hidden;
+}
+.slider__progress span {
+  display: block;
+  height: 100%;
+  width: 100%;
+  border-radius: 3px;
+  background: var(--brand);
+  transform-origin: left center;
+  transform: scaleX(.3);
+  transition: transform .2s linear;
+}
+
+/* ---------- Generated artwork (the "photo" in photo cards) ---------- */
+.art {
+  position: relative;
+  overflow: hidden;
+  background:
+    radial-gradient(130% 90% at 15% 0%, var(--c2) 0%, transparent 62%),
+    linear-gradient(165deg, var(--c2) -20%, var(--c1) 82%);
+}
+.art::before {
+  content: "";
+  position: absolute; inset: 0;
+  background-image: var(--grain);
+  background-size: 160px;
+  mix-blend-mode: overlay;
+  opacity: .5;
+  pointer-events: none;
+}
+.art__orb {
+  position: absolute;
+  width: 78%; aspect-ratio: 1;
+  top: -24%; right: -30%;
+  border-radius: 50%;
+  background: radial-gradient(circle at 32% 28%, rgb(255 255 255 / .55), rgb(255 255 255 / .08) 55%, transparent 70%);
+}
+.art__plate {
+  position: absolute;
+  width: 46%; aspect-ratio: 1;
+  left: -12%; bottom: 12%;
+  border-radius: 26%;
+  background: linear-gradient(145deg, rgb(255 255 255 / .28), rgb(255 255 255 / .03));
+  border: 1px solid rgb(255 255 255 / .3);
+  transform: rotate(-18deg);
+}
+.art__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
+
+.glyph {
+  display: grid; place-items: center;
+  color: #fff;
+  background: rgb(255 255 255 / .17);
+  -webkit-backdrop-filter: blur(6px);
+  backdrop-filter: blur(6px);
+  border: 1px solid rgb(255 255 255 / .42);
+  box-shadow: 0 18px 30px -12px rgb(0 0 0 / .45), inset 0 1px 0 rgb(255 255 255 / .5);
+  font: 800 34px/1 var(--font-display);
+}
+
+/* ---------- Photo card (platform / asset) ---------- */
+.pcard {
+  --c1: #2c5f46;
+  --c2: #b9d78f;
+  position: relative;
+  display: block;
+  aspect-ratio: 4 / 5;
+  border-radius: var(--r-l);
+  overflow: hidden;
+  isolation: isolate;
+  background: var(--c1);
+  box-shadow: var(--e2);
+  transition: transform .4s var(--ease), box-shadow .4s var(--ease);
+  -webkit-tap-highlight-color: transparent;
+  outline-offset: 4px;
+}
+.pcard .art { position: absolute; inset: 0; z-index: -1; }
+.pcard .art::after {
+  content: "";
+  position: absolute; inset: 0;
+  background: linear-gradient(115deg, transparent 35%, rgb(255 255 255 / .24) 48%, transparent 60%);
+  transform: translateX(-75%);
+  transition: transform .9s var(--ease);
+}
+.pcard:hover .art::after { transform: translateX(75%); }
+.pcard__glyph {
+  position: absolute;
+  left: 50%; top: 19%;
+  width: 84px; height: 84px;
+  margin-left: -42px;
+  border-radius: 26px;
+  transform: rotate(-5deg);
+  transition: transform .55s var(--ease);
+}
+.pcard__glyph .icon { width: 38px; height: 38px; }
+.pcard:hover .pcard__glyph { transform: translateY(-5px) rotate(0) scale(1.07); }
+
+.pcard__chip {
+  position: absolute;
+  top: 12px; left: 12px;
+  padding: 5px 10px;
+  border-radius: 999px;
+  background: rgb(15 22 17 / .36);
+  -webkit-backdrop-filter: blur(10px);
+  backdrop-filter: blur(10px);
+  border: 1px solid rgb(255 255 255 / .2);
+  color: #fff;
+  font-size: 11px;
+  font-weight: 600;
+  letter-spacing: .02em;
+}
+.pcard__caption {
+  position: absolute;
+  left: 10px; right: 10px; bottom: 10px;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 10px;
+  padding: 12px 12px 12px 14px;
+  border-radius: 15px;
+  background: rgb(14 22 17 / .42);
+  -webkit-backdrop-filter: blur(14px) saturate(1.3);
+  backdrop-filter: blur(14px) saturate(1.3);
+  border: 1px solid rgb(255 255 255 / .18);
+  color: #fff;
+}
+.pcard__text { display: grid; gap: 1px; min-width: 0; }
+.pcard__text strong { font: 700 15px/1.25 var(--font-display); letter-spacing: -.02em; }
+.pcard__text small { font-size: 12px; color: rgb(255 255 255 / .82); font-variant-numeric: tabular-nums; }
+.pcard__go {
+  flex: none;
+  width: 30px; height: 30px;
+  display: grid; place-items: center;
+  border-radius: 50%;
+  background: rgb(255 255 255 / .2);
+  transition: transform .3s var(--ease), background .3s;
+}
+.pcard__go .icon { width: 16px; height: 16px; }
+.pcard:hover .pcard__go { transform: translateX(2px); background: rgb(255 255 255 / .32); }
+
+.pcard:hover { transform: translateY(-6px); box-shadow: var(--e3); }
+/* Pressed: the card sinks and its shadow tightens */
+.pcard:active,
+.pcard.is-pressed { transform: translateY(-1px) scale(.975); box-shadow: var(--e1); transition-duration: .12s; }
+/* Selected: the card lifts and casts a shadow tinted with its own colour */
+.pcard.is-selected {
+  transform: translateY(-5px) scale(1.012);
+  box-shadow:
+    0 0 0 2px var(--bg),
+    0 0 0 4px var(--c1),
+    0 34px 54px -18px color-mix(in srgb, var(--c1) 75%, transparent),
+    var(--e3);
+}
+
+/* ---------- Variant card (listing, plan, pack) ---------- */
+.vcard {
+  --c1: #2c5f46;
+  --c2: #b9d78f;
+  position: relative;
+  display: flex;
+  flex-direction: column;
+  width: 100%;
+  padding: 0;
+  text-align: left;
+  border: 1px solid var(--line);
+  border-radius: var(--r-l);
+  background: var(--surface);
+  color: var(--text);
+  overflow: hidden;
+  box-shadow: var(--e1);
+  transition: transform .35s var(--ease), box-shadow .35s var(--ease), border-color .25s;
+  -webkit-tap-highlight-color: transparent;
+}
+.vcard:hover { transform: translateY(-4px); box-shadow: var(--e2); border-color: var(--line-strong); }
+.vcard:active { transform: translateY(0) scale(.985); box-shadow: var(--e1); transition-duration: .1s; }
+.vcard[aria-pressed="true"] {
+  transform: translateY(-5px);
+  border-color: var(--c1);
+  box-shadow:
+    0 0 0 2px var(--c1),
+    0 32px 50px -18px color-mix(in srgb, var(--c1) 70%, transparent),
+    var(--e3);
+}
+.vcard__art { height: 132px; flex: none; }
+.vcard__glyph {
+  position: absolute;
+  left: 16px; top: 104px;
+  width: 56px; height: 56px;
+  border-radius: 18px;
+  background: linear-gradient(150deg, var(--c2), var(--c1));
+  border: 3px solid var(--surface);
+  box-shadow: 0 10px 18px -8px color-mix(in srgb, var(--c1) 70%, transparent);
+  -webkit-backdrop-filter: none;
+  backdrop-filter: none;
+  transform: rotate(-6deg);
+  transition: transform .45s var(--ease);
+}
+.vcard__glyph .icon { width: 26px; height: 26px; }
+.vcard:hover .vcard__glyph { transform: translateY(-4px) rotate(0); }
+.vcard__big {
+  position: absolute;
+  right: 16px; top: 14px;
+  display: grid; justify-items: end;
+  color: #fff;
+  font: 800 54px/.9 var(--font-display);
+  letter-spacing: -.05em;
+  text-shadow: 0 6px 22px rgb(0 0 0 / .28);
+}
+.vcard__big small { margin-top: 6px; font: 600 12px/1 var(--font-sans); letter-spacing: .04em; opacity: .92; }
+.vcard__badge {
+  position: absolute;
+  left: 14px; top: 14px;
+  padding: 5px 10px;
+  border-radius: 999px;
+  background: rgb(14 22 17 / .38);
+  -webkit-backdrop-filter: blur(10px);
+  backdrop-filter: blur(10px);
+  border: 1px solid rgb(255 255 255 / .2);
+  color: #fff;
+  font-size: 11px;
+  font-weight: 600;
+}
+.vcard__check {
+  position: absolute;
+  right: 12px; bottom: 12px;
+  width: 28px; height: 28px;
+  display: grid; place-items: center;
+  border-radius: 50%;
+  background: #fff;
+  color: var(--c1);
+  transform: scale(0);
+  transition: transform .35s var(--ease);
+}
+.vcard__check .icon { width: 16px; height: 16px; stroke-width: 2.6; }
+.vcard[aria-pressed="true"] .vcard__check { transform: scale(1); }
+
+.vcard__body { display: grid; gap: 14px; padding: 40px 18px 18px; }
+.vcard__title { display: block; font: 700 18px/1.2 var(--font-display); letter-spacing: -.03em; }
+.vcard__ref { display: block; margin-top: 3px; font-size: 12px; color: var(--text-3); }
+.vcard__stats {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(84px, 1fr));
+  gap: 12px;
+  padding-top: 14px;
+  border-top: 1px dashed var(--line-strong);
+}
+.stat { display: grid; gap: 3px; }
+.stat__k { font-size: 12px; color: var(--text-3); }
+.stat__v { font: 700 15px/1.2 var(--font-display); font-variant-numeric: tabular-nums; }
+.vcard__foot { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
+.vcard__price { font: 800 26px/1 var(--font-display); letter-spacing: -.04em; font-variant-numeric: tabular-nums; }
+.vcard__price small { font: 500 13px var(--font-sans); letter-spacing: 0; color: var(--text-3); }
+.vcard__cta {
+  display: inline-flex; align-items: center; gap: 6px;
+  height: 34px; padding: 0 14px;
+  border-radius: 10px;
+  background: var(--sunken);
+  font-size: 13px;
+  font-weight: 600;
+  transition: background .25s, color .25s;
+}
+.vcard__cta-on { display: none; }
+.vcard:hover .vcard__cta { background: var(--brand-soft); color: var(--brand); }
+.vcard[aria-pressed="true"] .vcard__cta { background: var(--brand); color: var(--on-brand); }
+.vcard[aria-pressed="true"] .vcard__cta-off { display: none; }
+.vcard[aria-pressed="true"] .vcard__cta-on { display: inline; }
+
+/* ---------- Order bar ---------- */
+.orderbar {
+  position: fixed;
+  left: 50%;
+  bottom: calc(env(safe-area-inset-bottom, 0px) + 16px);
+  z-index: 55;
+  width: min(760px, calc(100% - 2 * max(16px, env(safe-area-inset-left, 0px))));
+  display: flex;
+  align-items: center;
+  gap: 16px;
+  padding: 12px 12px 12px 20px;
+  border-radius: 18px;
+  background: var(--surface);
+  border: 1px solid var(--line-strong);
+  box-shadow: var(--e3);
+  transform: translate(-50%, calc(100% + 40px));
+  transition: transform .5s var(--ease);
+}
+.orderbar.is-visible { transform: translate(-50%, 0); }
+.orderbar__info { display: grid; min-width: 0; flex: 1; }
+.orderbar__label { font-size: 12px; color: var(--text-3); }
+.orderbar__info strong { font: 700 15px/1.3 var(--font-display); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.orderbar__price { font: 800 22px/1 var(--font-display); letter-spacing: -.04em; font-variant-numeric: tabular-nums; }
+
+/* ---------- Toast ---------- */
+.toast {
+  position: fixed;
+  left: 50%;
+  bottom: calc(env(safe-area-inset-bottom, 0px) + 24px);
+  z-index: 90;
+  max-width: min(440px, calc(100% - 32px));
+  padding: 12px 18px;
+  border-radius: 12px;
+  background: var(--text);
+  color: var(--bg);
+  font-size: 14px;
+  font-weight: 500;
+  box-shadow: var(--e3);
+  opacity: 0;
+  pointer-events: none;
+  transform: translate(-50%, 14px);
+  transition: opacity .3s, transform .4s var(--ease), bottom .4s var(--ease);
+}
+.toast.is-visible { opacity: 1; transform: translate(-50%, 0); }
+body.has-orderbar .toast { bottom: calc(env(safe-area-inset-bottom, 0px) + 100px); }
+body.has-orderbar .site-footer { margin-bottom: 96px; }
+
+/* ---------- Details / FAQ ---------- */
+.faq { display: grid; gap: 10px; }
+.faq details {
+  border: 1px solid var(--line);
+  border-radius: var(--r-m);
+  background: var(--surface);
+  transition: border-color .2s, box-shadow .2s;
+}
+.faq details[open] { border-color: var(--line-strong); box-shadow: var(--e1); }
+.faq summary {
+  display: flex; align-items: center; justify-content: space-between; gap: 16px;
+  padding: 16px 18px;
+  font-weight: 600;
+  cursor: pointer;
+  list-style: none;
+}
+.faq summary::-webkit-details-marker { display: none; }
+.faq summary::after {
+  content: "";
+  flex: none;
+  width: 9px; height: 9px;
+  border-right: 2px solid var(--text-3);
+  border-bottom: 2px solid var(--text-3);
+  transform: rotate(45deg) translateY(-2px);
+  transition: transform .3s var(--ease);
+}
+.faq details[open] summary::after { transform: rotate(225deg) translateY(-2px); }
+.faq details p { padding: 0 18px 18px; max-width: 68ch; color: var(--text-2); }
+
+/* ---------- Footer ---------- */
+.site-footer { margin-top: 72px; padding-top: 48px; border-top: 1px solid var(--line); background: var(--surface-2); }
+.footer__grid {
+  display: grid;
+  grid-template-columns: 1.4fr repeat(2, 1fr);
+  gap: 40px;
+  padding-block: 44px 28px;
+}
+.footer__blurb { margin-top: 14px; max-width: 38ch; font-size: 14px; color: var(--text-2); }
+.footer__col h2 { font: 700 14px var(--font-display); margin-bottom: 12px; }
+.footer__col a { display: inline-block; padding: 4px 0; font-size: 14px; color: var(--text-2); transition: color .2s; }
+.footer__col a:hover { color: var(--brand); }
+.footer__col p { font-size: 14px; color: var(--text-2); max-width: 36ch; }
+.footer__base {
+  display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap;
+  padding-block: 18px 28px;
+  border-top: 1px solid var(--line);
+  font-size: 13px;
+  color: var(--text-3);
+}
+
+/* ---------- Back link ---------- */
+.back-link {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  height: 36px;
+  margin-bottom: 16px;
+  padding: 0 16px 0 10px;
+  border: 1px solid var(--line-strong);
+  border-radius: 999px;
+  background: var(--surface);
+  font-size: 14px;
+  font-weight: 600;
+  transition: transform .2s var(--ease), box-shadow .2s, border-color .2s;
+}
+.back-link .icon { width: 18px; height: 18px; transition: transform .25s var(--ease); }
+.back-link:hover { border-color: var(--text-3); box-shadow: var(--e2); }
+.back-link:hover .icon { transform: translateX(-3px); }
+.back-link:active { transform: scale(.96); box-shadow: var(--e1); }
+
+/* ---------- Let's talk ---------- */
+.talk {
+  position: relative;
+  display: grid;
+  grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr);
+  align-items: center;
+  gap: 40px;
+  margin-bottom: 8px;
+  padding: 48px;
+  border-radius: var(--r-xl);
+  background:
+    radial-gradient(60% 120% at 100% 0%, rgb(185 215 143 / .22), transparent 60%),
+    var(--talk-bg);
+  color: var(--talk-fg);
+  overflow: hidden;
+  box-shadow: var(--e3);
+}
+.talk h2 { font: 800 clamp(36px, 4.6vw, 60px)/1 var(--font-display); letter-spacing: -.055em; }
+.talk p { margin-top: 16px; max-width: 38ch; color: color-mix(in srgb, var(--talk-fg) 78%, transparent); }
+.talk__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
+.talk__tile {
+  display: flex;
+  flex-direction: column;
+  align-items: flex-start;
+  gap: 14px;
+  padding: 14px 14px 16px;
+  border-radius: 18px;
+  background: rgb(255 255 255 / .07);
+  border: 1px solid rgb(255 255 255 / .14);
+  transition: transform .3s var(--ease), background .25s, box-shadow .3s var(--ease);
+}
+.talk__tile:hover { transform: translateY(-4px); background: rgb(255 255 255 / .13); box-shadow: 0 20px 32px -16px rgb(0 0 0 / .55); }
+.talk__tile:active { transform: translateY(0) scale(.96); box-shadow: none; transition-duration: .1s; }
+.talk__icon {
+  width: 44px; height: 44px;
+  display: grid; place-items: center;
+  border-radius: 14px;
+  background: linear-gradient(150deg, var(--c2), var(--c1));
+  border: 1px solid rgb(255 255 255 / .3);
+  color: #fff;
+  box-shadow: inset 0 1px 0 rgb(255 255 255 / .4);
+}
+.talk__icon .icon { width: 21px; height: 21px; }
+.talk__label { font-size: 14px; font-weight: 600; }
+@media (max-width: 960px) {
+  .talk { grid-template-columns: 1fr; gap: 28px; padding: 32px 24px; }
+}
+@media (max-width: 560px) {
+  .talk__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+}
+
+/* ---------- Responsive ---------- */
+@media (max-width: 1100px) {
+  .slider__track { --cols: 4; }
+}
+@media (max-width: 800px) {
+  .slider__track { --cols: 3; }
+}
+@media (max-width: 860px) {
+  .nav { gap: 12px; }
+  .nav__menu { display: inline-grid; }
+  .nav__links {
+    position: absolute;
+    left: calc(-1 * var(--gutter)); right: calc(-1 * var(--gutter));
+    top: 100%;
+    display: none;
+    flex-direction: column;
+    padding: 10px var(--gutter) 16px;
+    background: var(--bg);
+    border-bottom: 1px solid var(--line);
+    box-shadow: var(--e2);
+  }
+  .site-header[data-menu="open"] .nav__links { display: flex; }
+  .nav__link { padding: 13px 12px; font-size: 16px; }
+  .footer__grid { grid-template-columns: 1fr 1fr; }
+  .footer__grid > :first-child { grid-column: 1 / -1; }
+}
+@media (max-width: 560px) {
+  .segmented { display: flex; }
+  .segmented__btn { flex: 1; padding: 11px 10px; font-size: 13px; }
+  .slider__head { align-items: flex-start; flex-direction: column; gap: 12px; }
+  .slider__title { font-size: 20px; }
+  .slider__track { --cols: 2.25; --gap: 12px; }
+  .pcard__glyph { width: 68px; height: 68px; margin-left: -34px; border-radius: 21px; }
+  .pcard__glyph .icon { width: 30px; height: 30px; }
+  .pcard__text strong { font-size: 14px; }
+  .orderbar { gap: 10px; padding: 10px 10px 10px 14px; }
+  .orderbar__price { font-size: 18px; }
+  .footer__grid { grid-template-columns: 1fr; gap: 28px; }
+}
+
+/* Phones: the catalogue slider becomes a plain grid that scrolls with the page, top to bottom */
+@media (max-width: 560px) {
+  .slider__track {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+    grid-template-rows: none;
+    grid-auto-flow: row;
+    grid-auto-columns: auto;
+    margin: 0;
+    padding: 4px 0 8px;
+    overflow: visible;
+    scroll-snap-type: none;
+    cursor: auto;
+  }
+  .slider__item { grid-row: auto !important; grid-column: auto !important; }
+  .slider__controls, .slider__progress { display: none; }
+  .discover__hint { display: none; }
+}
diff --git a/packages/module-registry/landings/verve/assets/css/pages.css b/packages/module-registry/landings/verve/assets/css/pages.css
new file mode 100644
index 0000000..e350faf
--- /dev/null
+++ b/packages/module-registry/landings/verve/assets/css/pages.css
@@ -0,0 +1,486 @@
+/* Page-level layout: hero, 3D stage, sections, category and platform pages, P2P */
+
+/* ---------- Hero and sub-hero ---------- */
+.hero,
+.subhero {
+  position: relative;
+  overflow: clip;
+  border-bottom: 1px solid var(--line);
+  background: radial-gradient(60% 95% at 78% 42%, color-mix(in srgb, var(--accent) 36%, transparent), transparent 70%);
+}
+.hero::before,
+.subhero::before {
+  content: "";
+  position: absolute; inset: 0;
+  background-image:
+    linear-gradient(var(--line) 1px, transparent 1px),
+    linear-gradient(90deg, var(--line) 1px, transparent 1px);
+  background-size: 56px 56px;
+  -webkit-mask-image: radial-gradient(70% 95% at 76% 45%, #000, transparent 78%);
+  mask-image: radial-gradient(70% 95% at 76% 45%, #000, transparent 78%);
+  opacity: .5;
+  pointer-events: none;
+}
+.hero__grid,
+.subhero__grid {
+  position: relative;
+  display: grid;
+  grid-template-columns: minmax(0, 1.02fr) minmax(0, .98fr);
+  align-items: center;
+  gap: 24px;
+}
+.hero__grid { min-height: clamp(330px, 38vh, 410px); }
+.subhero__grid { min-height: 236px; }
+.hero__copy { padding-block: 32px; max-width: 560px; }
+.subhero__copy { padding-block: 28px; max-width: 560px; }
+.hero h1 {
+  font: 800 clamp(38px, 4.8vw, 64px)/1.01 var(--font-display);
+  letter-spacing: -.05em;
+}
+.subhero h1 {
+  font: 800 clamp(32px, 3.6vw, 46px)/1.06 var(--font-display);
+  letter-spacing: -.045em;
+}
+.lede { margin-top: 14px; max-width: 46ch; font-size: clamp(15px, 1.25vw, 17px); color: var(--text-2); }
+.hero__actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 24px; }
+.hero__stage { position: relative; align-self: stretch; min-height: 300px; }
+.subhero .hero__stage { min-height: 220px; }
+
+.crumbs { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 14px; font-size: 13px; color: var(--text-3); }
+.crumbs a { transition: color .2s; }
+.crumbs a:hover { color: var(--brand); }
+.crumbs [aria-current] { color: var(--text-2); font-weight: 500; }
+.crumbs li + li::before { content: "/"; margin-right: 8px; color: var(--line-strong); }
+.crumbs { list-style: none; padding: 0; }
+.crumbs li { display: inline-flex; }
+
+/* ---------- Home hero: a short headline over an animated background ---------- */
+.hero--motion {
+  border-bottom: 0;
+  background: linear-gradient(180deg, color-mix(in srgb, var(--accent) 24%, var(--bg)) 0%, var(--bg) 100%);
+}
+.hero--motion::before { display: none; }
+.hero__motion {
+  position: absolute; inset: 0;
+  overflow: hidden;
+  -webkit-mask-image: linear-gradient(#000 72%, transparent);
+  mask-image: linear-gradient(#000 72%, transparent);
+}
+.hero__motion canvas { position: absolute; inset: 0; display: block; width: 100%; height: 100%; }
+.hero__inner { position: relative; padding-block: 44px 32px; }
+.hero--motion h1 {
+  max-width: none;
+  font: 800 clamp(30px, 3.9vw, 52px)/1.08 var(--font-display);
+  letter-spacing: -.05em;
+}
+.hero--motion .hero__sub { margin-top: 14px; max-width: 50ch; font-size: clamp(15px, 1.4vw, 18px); line-height: 1.5; color: var(--text-2); }
+.hero--motion .btn { height: 44px; padding: 0 22px; font-size: 15px; }
+
+/* ---------- 3D stage ---------- */
+.stage {
+  position: absolute; inset: 0;
+  perspective: 1100px;
+  perspective-origin: 50% 40%;
+  touch-action: pan-y;
+}
+.stage__glow {
+  position: absolute;
+  left: var(--stage-x, 50%); bottom: 6%;
+  width: 58%; height: 12%;
+  transform: translateX(-50%);
+  background: radial-gradient(closest-side, rgb(var(--shadow-rgb) / calc(.3 * var(--k))), transparent);
+  filter: blur(8px);
+}
+.stage__world {
+  position: absolute;
+  left: var(--stage-x, 50%); top: var(--stage-y, 50%);
+  width: 0; height: 0;
+  transform-style: preserve-3d;
+  will-change: transform;
+}
+.stage__orbit { position: absolute; left: 0; top: 0; width: 0; height: 0; transform-style: preserve-3d; }
+.stage__ring {
+  position: absolute;
+  border-radius: 50%;
+  border: 1px solid color-mix(in srgb, var(--brand) 34%, transparent);
+  transform: rotateX(90deg);
+}
+.stage__ring--inner { border-style: dashed; border-color: color-mix(in srgb, var(--brand) 24%, transparent); }
+
+.stage__tile {
+  --ts: 1;
+  position: absolute; left: 0; top: 0;
+  width: calc(60px * var(--ts)); height: calc(60px * var(--ts));
+  margin: calc(-30px * var(--ts)) 0 0 calc(-30px * var(--ts));
+  border-radius: calc(19px * var(--ts));
+  display: grid; place-items: center;
+  color: #fff;
+  background: linear-gradient(150deg, var(--c2), var(--c1));
+  border: 1px solid rgb(255 255 255 / .38);
+  box-shadow: inset 0 1px 0 rgb(255 255 255 / .5), inset 0 -12px 18px -8px rgb(0 0 0 / .26);
+  font: 800 calc(24px * var(--ts))/1 var(--font-display);
+  will-change: transform, opacity;
+}
+.stage__tile .icon { width: calc(26px * var(--ts)); height: calc(26px * var(--ts)); }
+
+.stage__core {
+  --s: 1;
+  position: absolute; left: 0; top: 0;
+  width: calc(150px * var(--s)); height: calc(196px * var(--s));
+  margin: calc(-98px * var(--s)) 0 0 calc(-75px * var(--s));
+  border-radius: calc(26px * var(--s));
+  transform-style: preserve-3d;
+  animation: stage-bob 6.5s ease-in-out infinite;
+}
+.stage__layer { position: absolute; inset: 0; border-radius: inherit; background: var(--c1); }
+.stage__layer--1 { transform: translateZ(calc(-7px * var(--s))); filter: brightness(.82); }
+.stage__layer--2 { transform: translateZ(calc(-14px * var(--s))); filter: brightness(.64); }
+.stage__face {
+  position: absolute; inset: 0;
+  display: flex; flex-direction: column; align-items: center; justify-content: center;
+  gap: calc(8px * var(--s));
+  border-radius: inherit;
+  overflow: hidden;
+  color: #fff;
+  background:
+    radial-gradient(120% 80% at 18% 0%, var(--c2), transparent 62%),
+    linear-gradient(160deg, var(--c2) -15%, var(--c1) 85%);
+  border: 1px solid rgb(255 255 255 / .45);
+  box-shadow: inset 0 1px 0 rgb(255 255 255 / .6), inset 0 -26px 40px -22px rgb(0 0 0 / .4);
+}
+.stage__face::before {
+  content: "";
+  position: absolute; inset: 0;
+  background-image: var(--grain);
+  background-size: 160px;
+  mix-blend-mode: overlay;
+  opacity: .45;
+}
+.stage__face::after {
+  content: "";
+  position: absolute; inset: -30% -70%;
+  background: linear-gradient(105deg, transparent 42%, rgb(255 255 255 / .3) 50%, transparent 58%);
+  transform: translateX(-60%);
+  animation: stage-sheen 7s ease-in-out infinite;
+}
+.stage__core-glyph {
+  position: relative; z-index: 1;
+  width: calc(70px * var(--s)); height: calc(70px * var(--s));
+  border-radius: calc(22px * var(--s));
+  font-size: calc(34px * var(--s));
+}
+.stage__core-glyph .icon { width: calc(34px * var(--s)); height: calc(34px * var(--s)); }
+.stage__face strong { position: relative; z-index: 1; font: 800 calc(18px * var(--s))/1.1 var(--font-display); letter-spacing: -.03em; }
+.stage__face small {
+  position: relative; z-index: 1;
+  max-width: 86%;
+  padding-inline: 4px;
+  text-align: center;
+  font-size: calc(12px * var(--s));
+  line-height: 1.25;
+  opacity: .9;
+}
+
+@keyframes stage-bob { 0%, 100% { transform: translateY(-7px); } 50% { transform: translateY(8px); } }
+@keyframes stage-sheen { 0%, 55% { transform: translateX(-60%); } 100% { transform: translateX(60%); } }
+
+/* ---------- Home: discover ---------- */
+.discover { padding-top: 6px; }
+.discover__bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 24px; }
+.discover__hint { font-size: 14px; color: var(--text-3); }
+
+/* ---------- Sections ---------- */
+.section { padding-top: 72px; }
+.section__head { max-width: 62ch; margin-bottom: 28px; }
+.section__title { font: 800 clamp(24px, 3vw, 32px)/1.15 var(--font-display); letter-spacing: -.04em; }
+.section__lede { margin-top: 8px; color: var(--text-2); }
+
+.steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; counter-reset: step; }
+.step {
+  position: relative;
+  padding: 24px;
+  border: 1px solid var(--line);
+  border-radius: var(--r-l);
+  background: var(--surface);
+  counter-increment: step;
+}
+.step::before {
+  content: counter(step);
+  display: grid; place-items: center;
+  width: 32px; height: 32px;
+  margin-bottom: 18px;
+  border-radius: 10px;
+  background: var(--brand-soft);
+  color: var(--brand);
+  font: 800 15px var(--font-display);
+}
+.step h3 { font: 700 18px/1.25 var(--font-display); letter-spacing: -.03em; }
+.step p { margin-top: 8px; color: var(--text-2); font-size: 15px; }
+
+.summary { display: grid; gap: 12px; }
+.summary__row {
+  display: grid;
+  grid-template-columns: 52px minmax(0, 1fr) auto auto 24px;
+  align-items: center;
+  gap: 20px;
+  padding: 16px 22px 16px 16px;
+  border: 1px solid var(--line);
+  border-radius: var(--r-l);
+  background: var(--surface);
+  box-shadow: var(--e1);
+  transition: transform .35s var(--ease), box-shadow .35s var(--ease), border-color .25s;
+}
+.summary__row:hover { transform: translateY(-3px); box-shadow: var(--e2); border-color: var(--line-strong); }
+.summary__row:active,
+.summary__row.is-pressed { transform: translateY(0) scale(.99); box-shadow: var(--e1); transition-duration: .1s; }
+.summary__row.is-selected { transform: translateY(-4px); border-color: var(--brand); box-shadow: 0 0 0 2px var(--brand), var(--e3); }
+.summary__icon { width: 52px; height: 52px; border-radius: 16px; background: linear-gradient(150deg, var(--c2), var(--c1)); }
+.summary__icon .icon { width: 24px; height: 24px; }
+.summary__name { display: grid; min-width: 0; }
+.summary__name strong { font: 700 17px/1.25 var(--font-display); letter-spacing: -.03em; }
+.summary__name small { color: var(--text-3); font-size: 14px; }
+.summary__count { color: var(--text-2); font-size: 14px; }
+.summary__from { font: 700 15px var(--font-display); font-variant-numeric: tabular-nums; }
+.summary__row > .icon { color: var(--text-3); width: 20px; height: 20px; transition: transform .3s var(--ease), color .2s; }
+.summary__row:hover > .icon { transform: translateX(3px); color: var(--brand); }
+
+/* ---------- Category and platform pages ---------- */
+.page-section { padding-top: 32px; }
+.toolbar { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 24px; }
+.toolbar__count { font-size: 14px; color: var(--text-3); font-variant-numeric: tabular-nums; }
+.search { position: relative; width: min(100%, 320px); }
+.search .icon { position: absolute; left: 14px; top: 50%; width: 18px; height: 18px; margin-top: -9px; color: var(--text-3); pointer-events: none; }
+.search input {
+  width: 100%;
+  height: 44px;
+  padding: 0 14px 0 42px;
+  border: 1px solid var(--line-strong);
+  border-radius: 12px;
+  background: var(--surface);
+  transition: border-color .2s, box-shadow .2s;
+}
+.search input:focus { outline: none; border-color: var(--brand); box-shadow: 0 0 0 3px color-mix(in srgb, var(--brand) 22%, transparent); }
+
+.card-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(204px, 1fr)); gap: 24px; padding-bottom: 20px; }
+.variants { display: grid; grid-template-columns: repeat(auto-fill, minmax(256px, 1fr)); gap: 22px; padding-bottom: 20px; }
+.empty { padding: 56px 20px; text-align: center; color: var(--text-2); border: 1px dashed var(--line-strong); border-radius: var(--r-l); }
+.empty h2 { font: 700 20px var(--font-display); color: var(--text); margin-bottom: 6px; }
+.empty .btn { margin-top: 18px; }
+.page-note { margin-top: 20px; font-size: 13px; color: var(--text-3); max-width: 72ch; }
+
+.info-grid { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: 40px; align-items: start; }
+
+/* ---------- P2P ---------- */
+.p2p-controls { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 18px; }
+.side-toggle { display: inline-grid; grid-template-columns: 1fr 1fr; padding: 4px; border-radius: 14px; background: var(--sunken); }
+.side-toggle button {
+  min-width: 112px;
+  padding: 10px 22px;
+  border: 0;
+  border-radius: 10px;
+  background: none;
+  color: var(--text-2);
+  font: 700 14px var(--font-sans);
+  transition: background .25s, color .25s, transform .15s var(--ease);
+}
+.side-toggle button:active { transform: scale(.96); }
+.side-toggle button[aria-pressed="true"][data-side="buy"] { background: var(--buy); color: var(--on-buy); }
+.side-toggle button[aria-pressed="true"][data-side="sell"] { background: var(--sell); color: var(--on-sell); }
+
+.assets { display: flex; gap: 8px; overflow-x: auto; max-width: 100%; padding: 2px; scrollbar-width: none; }
+.assets::-webkit-scrollbar { display: none; }
+.asset-chip {
+  display: inline-flex; align-items: center; gap: 8px;
+  height: 40px; padding: 0 16px 0 8px;
+  border: 1px solid var(--line-strong);
+  border-radius: 999px;
+  background: var(--surface);
+  font: 600 14px var(--font-sans);
+  white-space: nowrap;
+  transition: border-color .2s, box-shadow .2s, background .2s, transform .15s var(--ease);
+}
+.asset-chip:hover { border-color: var(--text-3); }
+.asset-chip:active { transform: scale(.96); }
+.asset-chip[aria-pressed="true"] { border-color: var(--brand); background: var(--brand-soft); box-shadow: 0 0 0 1px var(--brand); }
+.coin {
+  width: 26px; height: 26px;
+  display: inline-grid; place-items: center;
+  border-radius: 50%;
+  background: linear-gradient(150deg, var(--c2), var(--c1));
+  color: #fff;
+  font: 800 13px/1 var(--font-display);
+}
+
+.filters { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)) auto; gap: 12px; align-items: end; margin-bottom: 18px; }
+.field { display: grid; gap: 6px; min-width: 0; }
+.field__label { font-size: 13px; font-weight: 500; color: var(--text-2); }
+.field__control { position: relative; }
+.field input,
+.field select {
+  width: 100%;
+  height: 46px;
+  padding: 0 14px;
+  border: 1px solid var(--line-strong);
+  border-radius: 12px;
+  background: var(--surface);
+  font-variant-numeric: tabular-nums;
+  transition: border-color .2s, box-shadow .2s;
+  appearance: none;
+  -webkit-appearance: none;
+}
+.field select {
+  padding-right: 38px;
+  background-image: linear-gradient(45deg, transparent 50%, var(--text-3) 50%), linear-gradient(135deg, var(--text-3) 50%, transparent 50%);
+  background-position: calc(100% - 20px) 50%, calc(100% - 15px) 50%;
+  background-size: 5px 5px;
+  background-repeat: no-repeat;
+}
+.field input:focus,
+.field select:focus { outline: none; border-color: var(--brand); box-shadow: 0 0 0 3px color-mix(in srgb, var(--brand) 22%, transparent); }
+.field--suffix input { padding-right: 62px; }
+.field__suffix { position: absolute; right: 14px; top: 50%; transform: translateY(-50%); font-size: 13px; font-weight: 600; color: var(--text-3); pointer-events: none; }
+.btn .icon { width: 18px; height: 18px; }
+.btn.is-spinning .icon { animation: spin .7s linear infinite; }
+@keyframes spin { to { transform: rotate(360deg); } }
+
+.market-line { display: flex; flex-wrap: wrap; gap: 6px 22px; margin-bottom: 14px; font-size: 14px; color: var(--text-2); font-variant-numeric: tabular-nums; }
+.market-line strong { color: var(--text); font-weight: 700; }
+
+.offers { border: 1px solid var(--line); border-radius: var(--r-l); background: var(--surface); overflow: hidden; box-shadow: var(--e1); }
+.offers__head,
+.offer {
+  display: grid;
+  grid-template-columns: minmax(190px, 1.3fr) minmax(140px, 1fr) minmax(170px, 1.1fr) minmax(170px, 1.2fr) 124px;
+  gap: 18px;
+  align-items: center;
+  padding: 16px 22px;
+}
+.offers__head { padding-block: 12px; font-size: 13px; font-weight: 500; color: var(--text-3); background: var(--surface-2); border-bottom: 1px solid var(--line); }
+.offer { border-bottom: 1px solid var(--line); transition: background .2s, box-shadow .25s; }
+.offer:last-child { border-bottom: 0; }
+.offer:hover { background: var(--surface-2); }
+.offer__who { display: flex; align-items: center; gap: 12px; min-width: 0; }
+.avatar {
+  position: relative;
+  flex: none;
+  width: 38px; height: 38px;
+  display: grid; place-items: center;
+  border-radius: 12px;
+  background: linear-gradient(150deg, var(--c2), var(--c1));
+  color: #fff;
+  font: 800 15px var(--font-display);
+}
+.avatar i { position: absolute; right: -2px; bottom: -2px; width: 11px; height: 11px; border-radius: 50%; background: #54b36a; border: 2px solid var(--surface); }
+.offer__name { display: grid; min-width: 0; }
+.offer__name strong { font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.offer__name small { font-size: 13px; color: var(--text-3); font-variant-numeric: tabular-nums; }
+.offer__price { font: 800 20px/1.1 var(--font-display); letter-spacing: -.03em; font-variant-numeric: tabular-nums; }
+.offer__price small { font: 500 13px var(--font-sans); letter-spacing: 0; color: var(--text-3); }
+.offer__cell { display: grid; gap: 3px; font-size: 14px; font-variant-numeric: tabular-nums; }
+.offer__cell span { color: var(--text-3); font-size: 13px; }
+.offer__label { display: none; }
+.chips { display: flex; flex-wrap: wrap; gap: 6px; }
+.chip { padding: 4px 10px; border-radius: 999px; background: var(--sunken); font-size: 12px; font-weight: 600; color: var(--text-2); }
+.offer__act { justify-self: end; }
+.offers__state { padding: 52px 20px; text-align: center; color: var(--text-2); }
+.offers__state h2 { font: 700 20px var(--font-display); color: var(--text); margin-bottom: 6px; }
+
+.skeleton { position: relative; overflow: hidden; border-radius: 8px; background: var(--sunken); height: 16px; }
+.skeleton::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--surface) 70%, transparent), transparent); transform: translateX(-100%); animation: shimmer 1.2s infinite; }
+@keyframes shimmer { to { transform: translateX(100%); } }
+
+/* Order drawer */
+.drawer {
+  position: fixed;
+  inset: 0 0 0 auto;
+  margin: 0;
+  width: min(440px, 100%);
+  max-width: none;
+  height: 100dvh;
+  max-height: none;
+  padding: 0;
+  border: 0;
+  border-left: 1px solid var(--line-strong);
+  background: var(--surface);
+  color: var(--text);
+  box-shadow: var(--e3);
+}
+.drawer[open] { animation: drawer-in .38s var(--ease); }
+.drawer::backdrop { background: var(--scrim); animation: fade-in .3s; }
+@keyframes drawer-in { from { transform: translateX(40px); opacity: 0; } }
+@keyframes fade-in { from { opacity: 0; } }
+.drawer__inner { display: flex; flex-direction: column; height: 100%; }
+.drawer__head {
+  display: flex; align-items: flex-start; justify-content: space-between; gap: 12px;
+  padding: calc(env(safe-area-inset-top, 0px) + 22px) 22px 18px;
+  border-bottom: 1px solid var(--line);
+}
+.drawer__head p { font-size: 13px; font-weight: 700; }
+.drawer__head p.is-buy { color: var(--buy); }
+.drawer__head p.is-sell { color: var(--sell); }
+.drawer__head h2 { margin-top: 2px; font: 800 24px/1.15 var(--font-display); letter-spacing: -.04em; }
+.drawer__body { flex: 1; overflow-y: auto; padding: 20px 22px; display: grid; gap: 18px; align-content: start; }
+.facts { display: grid; grid-template-columns: 1fr 1fr; gap: 14px 18px; padding: 16px; border-radius: var(--r-m); background: var(--surface-2); }
+.facts div { display: grid; gap: 2px; }
+.facts dt { font-size: 12px; color: var(--text-3); }
+.facts dd { margin: 0; font: 700 15px var(--font-display); font-variant-numeric: tabular-nums; }
+.facts { margin: 0; }
+.pay-options { display: flex; flex-wrap: wrap; gap: 8px; }
+.pay-options button {
+  padding: 8px 14px;
+  border: 1px solid var(--line-strong);
+  border-radius: 999px;
+  background: var(--surface);
+  font-size: 13px;
+  font-weight: 600;
+  transition: border-color .2s, background .2s, transform .15s var(--ease);
+}
+.pay-options button:active { transform: scale(.95); }
+.pay-options button[aria-pressed="true"] { border-color: var(--brand); background: var(--brand-soft); color: var(--brand); box-shadow: 0 0 0 1px var(--brand); }
+.drawer__receive { display: flex; justify-content: space-between; align-items: baseline; padding: 14px 16px; border-radius: var(--r-m); border: 1px dashed var(--line-strong); }
+.drawer__receive span { font-size: 14px; color: var(--text-2); }
+.drawer__receive strong { font: 800 22px var(--font-display); letter-spacing: -.03em; font-variant-numeric: tabular-nums; }
+.form-error { min-height: 20px; font-size: 13px; font-weight: 500; color: var(--sell); }
+.drawer__terms { font-size: 13px; color: var(--text-3); }
+.drawer__foot { padding: 16px 22px calc(env(safe-area-inset-bottom, 0px) + 18px); border-top: 1px solid var(--line); }
+
+/* ---------- Responsive ---------- */
+@media (max-width: 960px) {
+  .hero__grid,
+  .subhero__grid { grid-template-columns: 1fr; gap: 0; }
+  .hero__copy { padding-bottom: 8px; }
+  .hero__stage { min-height: 300px; }
+  .subhero .hero__stage { min-height: 200px; margin-top: -8px; }
+  .steps { grid-template-columns: 1fr; }
+  .info-grid { grid-template-columns: 1fr; gap: 24px; }
+  .filters { grid-template-columns: 1fr 1fr; }
+  .filters .btn { grid-column: 1 / -1; }
+}
+
+@media (max-width: 900px) {
+  .offers__head { display: none; }
+  .offer {
+    grid-template-columns: minmax(0, 1fr) auto;
+    grid-template-areas: "who act" "price price" "limits limits" "pay pay";
+    gap: 12px 14px;
+    padding: 18px;
+  }
+  .offer__who { grid-area: who; }
+  .offer__act { grid-area: act; }
+  .offer__price { grid-area: price; }
+  .offer__cell--limits { grid-area: limits; grid-template-columns: 1fr 1fr; gap: 12px; }
+  .offer__cell--limits > div { display: grid; gap: 2px; }
+  .offer__cell--pay { grid-area: pay; }
+}
+
+@media (max-width: 640px) {
+  .summary__row { grid-template-columns: 48px minmax(0, 1fr) 20px; gap: 14px; padding: 14px; }
+  .summary__count, .summary__from { display: none; }
+  .summary__icon { width: 48px; height: 48px; }
+  .card-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
+  .variants { grid-template-columns: 1fr; }
+  .filters { grid-template-columns: 1fr; }
+  .side-toggle { width: 100%; }
+  .side-toggle button { min-width: 0; }
+  .section { padding-top: 56px; }
+}
diff --git a/packages/module-registry/landings/verve/assets/css/tokens.css b/packages/module-registry/landings/verve/assets/css/tokens.css
new file mode 100644
index 0000000..aa2e1f6
--- /dev/null
+++ b/packages/module-registry/landings/verve/assets/css/tokens.css
@@ -0,0 +1,137 @@
+/*
+ * Verve design tokens.
+ *
+ * Direction: a quiet paper-and-ink storefront. Everything is restrained so the
+ * 3D hero scene and the photo cards are the only expressive things on screen.
+ *
+ * Palette (light): paper #f5f3eb, ink #17241c, pine #2c5f46, sage #b9d78f, clay #a24e3c.
+ * Type: Manrope for display, DM Sans for text. Numbers use tabular figures.
+ */
+:root {
+  color-scheme: light;
+
+  --font-display: 'Manrope', 'DM Sans', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
+  --font-sans: 'DM Sans', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
+
+  /* Surfaces */
+  --bg: #f5f3eb;
+  --surface: #fffefa;
+  --surface-2: #f0efe5;
+  --sunken: #e8e7dc;
+
+  /* Text */
+  --text: #17241c;
+  --text-2: #46534a;
+  --text-3: #637066;
+
+  /* Lines */
+  --line: #dcddd0;
+  --line-strong: #c3c8b7;
+
+  /* Brand */
+  --brand: #2c5f46;
+  --brand-hover: #224c37;
+  --on-brand: #ffffff;
+  --brand-soft: #e1ebd7;
+  --accent: #b9d78f;
+
+  /* Trade sides */
+  --buy: #2c5f46;
+  --on-buy: #ffffff;
+  --buy-soft: #e1ebd7;
+  --sell: #a24e3c;
+  --on-sell: #ffffff;
+  --sell-soft: #f4e1da;
+
+  --scrim: rgb(14 22 17 / 0.55);
+
+  /* "Let's talk" panel */
+  --talk-bg: #1a3a29;
+  --talk-fg: #eef3ea;
+
+  /* Elevation (shadow colour and strength follow the theme) */
+  --shadow-rgb: 24 37 29;
+  --k: 1;
+  --e1: 0 1px 2px rgb(var(--shadow-rgb) / calc(0.07 * var(--k)));
+  --e2: 0 10px 22px -10px rgb(var(--shadow-rgb) / calc(0.2 * var(--k))),
+        0 2px 5px rgb(var(--shadow-rgb) / calc(0.06 * var(--k)));
+  --e3: 0 28px 52px -22px rgb(var(--shadow-rgb) / calc(0.42 * var(--k))),
+        0 10px 18px -10px rgb(var(--shadow-rgb) / calc(0.16 * var(--k)));
+
+  /* Shape */
+  --r-s: 8px;
