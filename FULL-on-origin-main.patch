@@ -0,0 +1,129 @@
+/**
+ * lib/module-clerk-service.ts — W1-P5: module accounts for people who sign in with Clerk social providers (Google / Facebook / GitHub).
+ *
+ * The caller has ALREADY proven the Clerk identity (route: lib/clerk-verify.ts against the module's own Clerk application; webhook:
+ * Svix signature with the module's own secret). This file only maps `(module, Clerk user id)` to a module account:
+ *   - clerkSignIn:        existing identity -> its account's session; unknown identity -> create backing user + account +
+ *                         backing link + identity row, then a session. Never links by email (see EMAIL_ACCOUNT_EXISTS).
+ *   - clerkUserCreated:   webhook user.created -> the same account creation, no session. Idempotent with clerkSignIn.
+ *   - clerkUserDeleted:   webhook user.deleted -> identity row removed, account closed, its sessions revoked. Data is kept.
+ * The Clerk user id is only ever looked up together with the module, so the same id string in two modules is two unrelated rows.
+ */
+import { randomBytes } from "node:crypto";
+import { isKnownModuleId } from "./module-session-policy";
+import type { ModuleId } from "@ayzen/module-registry";
+import { audit, insertSession, type AuthDb, type ClientInfo, type Fail, type IssuedModuleSession } from "./module-auth-service";
+
+type Query = AuthDb["query"];
+const isUnique = (e: unknown) => (e as any)?.code === "23505";
+const CLERK_ID = /^user_[A-Za-z0-9]{8,64}$/;
+
+interface Profile { email?: string | null; emailVerified?: boolean }
+
+/** Creates the backing user + module account + backing link + identity row. Caller holds the transaction. */
+async function createAccount(q: Query, module: ModuleId, clerkUserId: string, profile: Profile) {
+  const tag = randomBytes(12).toString("hex");
+  // Same non-deliverable, un-loginable backing row as a password signup (lib/module-auth-service.ts signupWithPassword).
+  const u = await q(
+    `INSERT INTO users (username, email, password_hash, role, status, email_verified) VALUES ($1, $2, '', 'user', 'active', FALSE) RETURNING id`,
+    [`m_${module}_${tag}`, `m-${module}-${tag}@module-accounts.invalid`],
+  );
+  const userId: number = u.rows[0].id;
+  const acct = (await q(`SELECT id, module_uid FROM ayzen_provision_module_account($1::int, $2, 'signup')`, [userId, module])).rows[0];
+  await q(`INSERT INTO module_account_links (module_account_id, module, ayzen_user_id, method) VALUES ($1, $2, $3, 'backing')`, [acct.id, module, userId]);
+  await q(
+    `INSERT INTO module_external_identities (module_account_id, module, provider, external_id, email, email_verified) VALUES ($1, $2, 'clerk', $3, $4, $5)`,
+    [acct.id, module, clerkUserId, profile.email?.slice(0, 320) ?? null, profile.emailVerified === true],
+  );
+  return { userId, accountId: acct.id as number, moduleUid: acct.module_uid as string };
+}
+
+const findIdentity = (q: Query, module: ModuleId, clerkUserId: string) => q(
+  `SELECT i.module_account_id, a.user_id, a.status, a.module_uid, u.status AS user_status
+     FROM module_external_identities i
+     JOIN module_accounts a ON a.id = i.module_account_id
+     JOIN users u ON u.id = a.user_id
+    WHERE i.module = $1 AND i.provider = 'clerk' AND i.external_id = $2`,
+  [module, clerkUserId],
+);
+
+export async function clerkSignIn(
+  db: AuthDb,
+  input: { module: unknown; clerkUserId: unknown; email?: string | null; emailVerified?: boolean; client: ClientInfo },
+): Promise<({ ok: true; created: boolean } & IssuedModuleSession) | Fail> {
+  if (!isKnownModuleId(input.module)) return { ok: false, code: "INVALID_MODULE" };
+  if (typeof input.clerkUserId !== "string" || !CLERK_ID.test(input.clerkUserId)) return { ok: false, code: "INVALID_TOKEN" };
+  const module = input.module, clerkUserId = input.clerkUserId;
+
+  const attempt = (): Promise<({ ok: true; created: boolean } & IssuedModuleSession) | Fail> => db.transaction(async (q) => {
+    const found = (await findIdentity(q, module, clerkUserId)).rows[0];
+    if (found) {
+      if (found.status !== "active" || found.user_status === "banned" || found.user_status === "suspended") {
+        await audit(q, module, found.module_account_id, "clerk_login", "failure", input.client, { status: found.status, userStatus: found.user_status });
+        return { ok: false, code: "ACCOUNT_NOT_ACTIVE" } as Fail;
+      }
+      await q(`UPDATE module_external_identities SET last_login_at = NOW(), email = COALESCE($3, email), email_verified = email_verified OR $4
+                WHERE module = $1 AND provider = 'clerk' AND external_id = $2`, [module, clerkUserId, input.email?.slice(0, 320) ?? null, input.emailVerified === true]);
+      const session = await insertSession(q, { userId: found.user_id, moduleAccountId: found.module_account_id, module, moduleUid: found.module_uid }, input.client);
+      await audit(q, module, found.module_account_id, "clerk_login", "success", input.client, { created: false });
+      return { ok: true, created: false, ...session } as const;
+    }
+    // New identity. A verified email that already belongs to a password account in THIS module is refused rather than merged:
+    // silently attaching a social login to an existing account is an account-takeover path if either side's email is not what it seems.
+    const email = input.email?.trim().toLowerCase();
+    if (email && input.emailVerified === true) {
+      const clash = await q(`SELECT module_account_id FROM module_credentials WHERE module = $1 AND identifier_norm = $2`, [module, email]);
+      if (clash.rows.length > 0) {
+        await audit(q, module, clash.rows[0].module_account_id, "clerk_login", "failure", input.client, { reason: "email_account_exists" });
+        return { ok: false, code: "EMAIL_ACCOUNT_EXISTS" } as Fail;
+      }
+    }
+    const a = await createAccount(q, module, clerkUserId, { email: input.email, emailVerified: input.emailVerified });
+    const session = await insertSession(q, { userId: a.userId, moduleAccountId: a.accountId, module, moduleUid: a.moduleUid }, input.client);
+    await audit(q, module, a.accountId, "clerk_login", "success", input.client, { created: true });
+    return { ok: true, created: true, ...session } as const;
+  });
+
+  try { return await attempt(); }
+  catch (e) {
+    // Two first sign-ins of the same Clerk user racing: the unique index picked a winner; the loser now simply finds it.
+    if (isUnique(e)) return attempt();
+    throw e;
+  }
+}
+
+/** Webhook user.created: idempotent; `created` is false when the identity already existed (e.g. the person signed in first). */
+export async function clerkUserCreated(
+  db: AuthDb, input: { module: unknown; clerkUserId: unknown; email?: string | null; emailVerified?: boolean },
+): Promise<{ ok: true; created: boolean } | Fail> {
+  if (!isKnownModuleId(input.module)) return { ok: false, code: "INVALID_MODULE" };
+  if (typeof input.clerkUserId !== "string" || !CLERK_ID.test(input.clerkUserId)) return { ok: false, code: "INVALID_TOKEN" };
+  const module = input.module, clerkUserId = input.clerkUserId;
+  const attempt = () => db.transaction(async (q) => {
+    if ((await findIdentity(q, module, clerkUserId)).rows[0]) return { ok: true, created: false } as const;
+    const a = await createAccount(q, module, clerkUserId, { email: input.email, emailVerified: input.emailVerified });
+    await audit(q, module, a.accountId, "clerk_user_created", "success", null, {});
+    return { ok: true, created: true } as const;
+  });
+  try { return await attempt(); } catch (e) { if (isUnique(e)) return attempt(); throw e; }
+}
+
+/** Webhook user.deleted: the identity is gone for good, so the account is closed and every session of it revoked. Rows and data stay. */
+export async function clerkUserDeleted(
+  db: AuthDb, input: { module: unknown; clerkUserId: unknown },
+): Promise<{ ok: true; closed: boolean; sessionsRevoked: number } | Fail> {
+  if (!isKnownModuleId(input.module)) return { ok: false, code: "INVALID_MODULE" };
+  if (typeof input.clerkUserId !== "string" || !CLERK_ID.test(input.clerkUserId)) return { ok: false, code: "INVALID_TOKEN" };
+  const module = input.module, clerkUserId = input.clerkUserId;
+  return db.transaction(async (q) => {
+    const row = (await q(
+      `DELETE FROM module_external_identities WHERE module = $1 AND provider = 'clerk' AND external_id = $2 RETURNING module_account_id`,
+      [module, clerkUserId],
+    )).rows[0];
+    if (!row) return { ok: true, closed: false, sessionsRevoked: 0 } as const;
+    await q(`UPDATE module_accounts SET status = 'closed', updated_at = NOW() WHERE id = $1 AND module = $2 AND status <> 'closed'`, [row.module_account_id, module]);
+    const revoked = await q(`UPDATE user_sessions SET revoked_at = NOW() WHERE module_account_id = $1 AND module = $2 AND revoked_at IS NULL`, [row.module_account_id, module]);
+    await audit(q, module, row.module_account_id, "clerk_user_deleted", "success", null, { sessionsRevoked: revoked.rowCount ?? 0 });
+    return { ok: true, closed: true, sessionsRevoked: revoked.rowCount ?? 0 } as const;
+  });
+}
diff --git a/artifacts/api-server/src/lib/module-host-guard-core.ts b/artifacts/api-server/src/lib/module-host-guard-core.ts
new file mode 100644
index 0000000..46cf01b
--- /dev/null
+++ b/artifacts/api-server/src/lib/module-host-guard-core.ts
@@ -0,0 +1,67 @@
+/**
+ * lib/module-host-guard-core.ts — W2-P1: the pure half of the module host guard (mode switch, decision, registered-origin check,
+ * frame-ancestors value). No logger, no express: importable by tests and scripts without installing anything.
+ * The middleware that uses it is lib/module-host-guard.ts (read its header for the full design).
+ */
+import { decideModuleHostAccess, type ModuleId } from "@ayzen/module-registry";
+import { getApiHosts, getMcpHosts, isFirstPartyProdOrigin } from "./api-hosts";
+import { SHARED_APP_DEFINITIONS, getSharedAppHosts } from "./shared-apps";
+import { ROLE_HOST_DEFINITIONS, getCentralHosts, getRoleHostHosts, normalizeHostname } from "./role-hosts";
+
+export type ModuleHostGuardMode = "off" | "report" | "owned" | "strict";
+const MODES: readonly ModuleHostGuardMode[] = ["off", "report", "owned", "strict"];
+
+export function moduleHostGuardMode(env: NodeJS.ProcessEnv = process.env): ModuleHostGuardMode {
+  const raw = env.MODULE_HOST_GUARD_MODE?.trim().toLowerCase();
+  return (MODES as readonly string[]).includes(raw ?? "") ? (raw as ModuleHostGuardMode) : "off";
+}
+/** owned / strict: the guard refuses requests and the CORS + header tightening is on. */
+export const isModuleHostGuardEnforcing = (env: NodeJS.ProcessEnv = process.env): boolean => {
+  const m = moduleHostGuardMode(env);
+  return m === "owned" || m === "strict";
+};
+
+export function sharedPrefixes(env: NodeJS.ProcessEnv = process.env): string[] {
+  return (env.MODULE_HOST_GUARD_SHARED_PREFIXES ?? "").split(",").map((p) => p.trim().toLowerCase()).filter((p) => p.startsWith("/"));
+}
+
+/** Pure core, exported for tests: what the guard does for (mode, module, path). */
+export function evaluateGuard(mode: ModuleHostGuardMode, module: ModuleId | null, path: string, env: NodeJS.ProcessEnv = process.env) {
+  if (mode === "off" || !module) return { refuse: false as const, wouldDeny: false, reason: "n/a" };
+  const d = decideModuleHostAccess({ module, path, strict: mode === "strict", sharedPrefixes: sharedPrefixes(env) });
+  const wouldDeny = d.action === "deny";
+  return { refuse: wouldDeny && mode !== "report", wouldDeny, reason: d.reason };
+}
+
+// ─── per-module CORS allow-list ──────────────────────────────────────────────────────────────────────────────────
+
+function registeredHosts(env: NodeJS.ProcessEnv = process.env): Set<string> {
+  const hosts = new Set<string>([...getApiHosts(), ...getMcpHosts(), ...getCentralHosts(env)]);
+  for (const d of SHARED_APP_DEFINITIONS) for (const h of getSharedAppHosts(d)) hosts.add(h);
+  for (const d of ROLE_HOST_DEFINITIONS) for (const h of getRoleHostHosts(d, env)) hosts.add(h);
+  for (const raw of [env.AYZEN_OIDC_ISSUER, env.APP_URL]) { try { if (raw) hosts.add(normalizeHostname(new URL(raw).host)); } catch { /* ignore */ } }
+  for (const h of (env.MODULE_CORS_EXTRA_HOSTS ?? "").split(",")) if (h.trim()) hosts.add(normalizeHostname(h));
+  return hosts;
+}
+
+/**
+ * Production first-party origins are only trusted when they are a REGISTERED host (module, role, central, API, MCP, OIDC
+ * issuer, or MODULE_CORS_EXTRA_HOSTS), not merely "<anything>.ayzen.tech": a forgotten or hijacked subdomain gets no CORS.
+ * Origins that are not production first-party (localhost dev, explicit ALLOWED_ORIGINS) are left to the existing rules.
+ */
+export function isRegisteredFirstPartyOrigin(origin: string, env: NodeJS.ProcessEnv = process.env): boolean {
+  if (!isFirstPartyProdOrigin(origin)) return true;
+  try { return registeredHosts(env).has(normalizeHostname(new URL(origin).host)); } catch { return false; }
+}
+
+// ─── per-module response headers ─────────────────────────────────────────────────────────────────────────────────
+
+/**
+ * On a module's own host: `frame-ancestors 'self'` (+ MODULE_FRAME_ANCESTORS_EXTRA origins) so no other site, and no other
+ * module, can embed it, and an explicit `Referrer-Policy: no-referrer`. Only the frame-ancestors directive is set, so it
+ * cannot break scripts or styles; helmet's X-Frame-Options: SAMEORIGIN already says the same for old browsers.
+ */
+export function moduleFrameAncestors(env: NodeJS.ProcessEnv = process.env): string {
+  const extra = (env.MODULE_FRAME_ANCESTORS_EXTRA ?? "").split(",").map((s) => s.trim()).filter((s) => /^https:\/\/[a-z0-9.-]+$/i.test(s));
+  return ["'self'", ...extra].join(" ");
+}
diff --git a/artifacts/api-server/src/lib/module-host-guard.test.ts b/artifacts/api-server/src/lib/module-host-guard.test.ts
new file mode 100644
index 0000000..41c487d
--- /dev/null
+++ b/artifacts/api-server/src/lib/module-host-guard.test.ts
@@ -0,0 +1,94 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { MODULES, MODULE_HOST_ALLOWED_PREFIXES, decideModuleHostAccess, pathCandidates } from "@ayzen/module-registry";
+import {
+  evaluateGuard, isModuleHostGuardEnforcing, isRegisteredFirstPartyOrigin, moduleFrameAncestors, moduleHostGuardMode, sharedPrefixes,
+} from "./module-host-guard-core";
+
+const env = (o: Record<string, string> = {}) => o as NodeJS.ProcessEnv;
+const own = (m: { routePrefixes: readonly string[] }) => m.routePrefixes[0];
+
+test("mode: unknown or missing value is off; only owned|strict enforce", () => {
+  assert.equal(moduleHostGuardMode(env()), "off");
+  assert.equal(moduleHostGuardMode(env({ MODULE_HOST_GUARD_MODE: "STRICT " })), "strict");
+  assert.equal(moduleHostGuardMode(env({ MODULE_HOST_GUARD_MODE: "yes" })), "off");
+  assert.equal(isModuleHostGuardEnforcing(env({ MODULE_HOST_GUARD_MODE: "report" })), false);
+  assert.equal(isModuleHostGuardEnforcing(env({ MODULE_HOST_GUARD_MODE: "owned" })), true);
+});
+
+test("isolation matrix: every module host gets 404 on every OTHER module's prefix, and keeps its own + plumbing", () => {
+  for (const m of MODULES) for (const other of MODULES) for (const p of other.routePrefixes) {
+    const d = decideModuleHostAccess({ module: m.id, path: `${p}/x` });
+    if (other.id === m.id) assert.equal(d.action, "allow", `${m.id} must keep ${p}`);
+    else assert.deepEqual([d.action, d.owner], ["deny", other.id], `${m.id} -> ${p}`);
+  }
+  for (const m of MODULES) for (const a of MODULE_HOST_ALLOWED_PREFIXES) {
+    assert.equal(decideModuleHostAccess({ module: m.id, path: `${a}/x`, strict: true }).action, "allow", `${m.id} ${a}`);
+  }
+});
+
+test("registry sanity: no prefix is owned by two modules, none collides with the allow-list", () => {
+  const seen = new Map<string, string>();
+  for (const m of MODULES) for (const p of m.routePrefixes) {
+    assert.ok(!seen.has(p), `${p} owned by ${seen.get(p)} and ${m.id}`);
+    seen.set(p, m.id);
+    assert.ok(!MODULE_HOST_ALLOWED_PREFIXES.some((a) => p === a || p.startsWith(a + "/")), `${p} collides with allow-list`);
+  }
+});
+
+test("path tricks cannot reach another module: case, //, ./.., percent-encoding, query, allow-list laundering", () => {
+  const fyra = MODULES.find((m) => m.id === "fyra")!, p = own(fyra); // /finance
+  const tricks = [p.toUpperCase(), `/${p}`, `/./${p.slice(1)}`, `/vault/../${p.slice(1)}`, `/auth/../${p.slice(1)}`, `/health/..${p}`,
+    "/%66inance", "/%46INANCE/x", `${p}?next=/vault`, `${p}#/vault`, `/oidc/%2e%2e${p}`];
+  for (const t of tricks) for (const strict of [false, true]) {
+    assert.equal(decideModuleHostAccess({ module: "sylo", path: t, strict }).action, "deny", `${t} (strict=${strict})`);
+  }
+  for (const bad of ["/%zz", "/a%00b", "/a\\b", "/%5cfinance"]) assert.equal(decideModuleHostAccess({ module: "sylo", path: bad }).reason, "malformed_path", bad);
+  assert.equal(pathCandidates("/%zz"), null);
+});
+
+test("an allow-listed prefix is a boundary, not a substring", () => {
+  assert.equal(decideModuleHostAccess({ module: "sylo", path: "/authx/y", strict: true }).action, "deny");
+  assert.equal(decideModuleHostAccess({ module: "sylo", path: "/auth", strict: true }).action, "allow");
+  assert.equal(decideModuleHostAccess({ module: "sylo", path: "/.well-known/openid-configuration", strict: true }).action, "allow");
+  assert.equal(decideModuleHostAccess({ module: "sylo", path: "/vaultx", strict: false }).action, "allow"); // unowned, not "vault"
+});
+
+test("unowned paths: allowed in owned mode, denied in strict unless shared-listed", () => {
+  assert.equal(decideModuleHostAccess({ module: "sylo", path: "/users/me" }).action, "allow");
+  assert.equal(decideModuleHostAccess({ module: "sylo", path: "/users/me", strict: true }).action, "deny");
+  assert.equal(decideModuleHostAccess({ module: "sylo", path: "/users/me", strict: true, sharedPrefixes: ["/users"] }).action, "allow");
+  assert.deepEqual(sharedPrefixes(env({ MODULE_HOST_GUARD_SHARED_PREFIXES: "/users, /Notifications ,bad,/x" })), ["/users", "/notifications", "/x"]);
+});
+
+test("unknown module id never gets access", () => {
+  assert.equal(decideModuleHostAccess({ module: "nope", path: "/auth" }).action, "deny");
+});
+
+test("evaluateGuard: off and no-module are never refused; report logs but does not refuse; owned/strict refuse", () => {
+  assert.equal(evaluateGuard("off", "sylo", "/finance").refuse, false);
+  assert.equal(evaluateGuard("owned", null, "/finance").refuse, false);
+  const rep = evaluateGuard("report", "sylo", "/finance");
+  assert.deepEqual([rep.refuse, rep.wouldDeny], [false, true]);
+  assert.equal(evaluateGuard("owned", "sylo", "/finance").refuse, true);
+  assert.equal(evaluateGuard("owned", "sylo", "/vault/items").refuse, false);
+  assert.equal(evaluateGuard("owned", "sylo", "/users").refuse, false);
+  assert.equal(evaluateGuard("strict", "sylo", "/users").refuse, true);
+});
+
+test("per-module CORS: only registered first-party hosts; localhost and non-first-party are not this check's business", () => {
+  const e = env();
+  for (const m of MODULES) assert.equal(isRegisteredFirstPartyOrigin(m.defaultHost ? `https://${m.defaultHost}` : "", e), true, m.id);
+  for (const ok of ["https://api.ayzen.tech", "https://ayzen.tech", "https://admin.ayzen.tech", "https://mod.ayzen.tech", "https://team.ayzen.tech", "https://mcp.ayzen.tech"]) assert.equal(isRegisteredFirstPartyOrigin(ok, e), true, ok);
+  assert.equal(isRegisteredFirstPartyOrigin("https://forgotten.ayzen.tech", e), false);
+  assert.equal(isRegisteredFirstPartyOrigin("https://id.ayzen.tech", e), false, "OIDC issuer host is trusted only when configured");
+  assert.equal(isRegisteredFirstPartyOrigin("https://id.ayzen.tech", env({ AYZEN_OIDC_ISSUER: "https://id.ayzen.tech" })), true);
+  assert.equal(isRegisteredFirstPartyOrigin("https://x.ayzen.tech", env({ MODULE_CORS_EXTRA_HOSTS: "X.ayzen.tech" })), true);
+  assert.equal(isRegisteredFirstPartyOrigin("http://sylo.localhost", e), true);
+  assert.equal(isRegisteredFirstPartyOrigin("https://evil.example", e), true, "not first-party: left to ALLOWED_ORIGINS");
+});
+
+test("frame-ancestors: self plus https extras only", () => {
+  assert.equal(moduleFrameAncestors(env()), "'self'");
+  assert.equal(moduleFrameAncestors(env({ MODULE_FRAME_ANCESTORS_EXTRA: "https://ayzen.tech, http://bad.test, *, https://x.y;script-src" })), "'self' https://ayzen.tech");
+});
diff --git a/artifacts/api-server/src/lib/module-host-guard.ts b/artifacts/api-server/src/lib/module-host-guard.ts
new file mode 100644
index 0000000..da572d3
--- /dev/null
+++ b/artifacts/api-server/src/lib/module-host-guard.ts
@@ -0,0 +1,60 @@
+/**
+ * lib/module-host-guard.ts — W2-P1 (req 4): the server stops trusting the browser to keep modules apart.
+ *
+ * shared-apps.ts only maps host -> module; it never blocked anything, so a page on sylo.ayzen.tech could call another
+ * module's API. This file adds the enforcement, controlled by ONE switch:
+ *
+ *   MODULE_HOST_GUARD_MODE   off (default) | report | owned | strict
+ *     off     nothing changes.
+ *     report  log `module_host_guard.would_deny` for what owned/strict would refuse; refuse nothing. Use it first.
+ *     owned   a request acting for module M gets a plain 404 on any path owned by ANOTHER module (registry routePrefixes).
+ *             Paths owned by nobody (shared platform APIs) stay reachable. Recommended steady state.
+ *     strict  as owned, and unowned paths are 404 too unless allow-listed (/auth /oidc /.well-known /health /connector)
+ *             or listed in MODULE_HOST_GUARD_SHARED_PREFIXES (comma list). NOT recommended until the registry's route
+ *             ownership is complete: today ~half of the API surface (e.g. /users, /notifications, /vault-shares) is unowned.
+ *   owned and strict additionally turn on: a per-module CORS allow-list (a first-party origin must be a REGISTERED host,
+ *   not just any *.ayzen.tech) and per-module response headers (CSP frame-ancestors, Referrer-Policy) on module hosts.
+ *
+ * "Acting for module M" is lib/module-request-context.ts: the first-party Origin when the browser sent one, else the Host.
+ * Requests with no module context (central app, API host without a module Origin, workers, curl) are not touched: this is
+ * defence in depth for browser traffic, and authentication/authorization stay owned by the existing middleware.
+ * A denied request gets the SAME 404 body as an unknown endpoint, so the response does not reveal that the path exists.
+ */
+import type { NextFunction, Request, RequestHandler, Response } from "express";
+import type { ModuleId } from "@ayzen/module-registry";
+import { logger } from "./logger";
+import { currentModuleContext } from "./module-request-context";
+import { resolveRequestModule } from "./module-session-policy";
+import { isApiHost } from "./api-hosts";
+import { evaluateGuard, isModuleHostGuardEnforcing, moduleFrameAncestors, moduleHostGuardMode } from "./module-host-guard-core";
+import { notFoundHandler } from "../middlewares/error-handler";
+
+export * from "./module-host-guard-core";
+
+function apply(kind: "api" | "page", module: ModuleId | null, req: Request, res: Response, next: NextFunction): void {
+  const mode = moduleHostGuardMode();
+  const r = evaluateGuard(mode, module, req.path);
+  if (r.wouldDeny) logger.warn({ module, path: req.path, method: req.method, kind, mode, reason: r.reason }, mode === "report" ? "module_host_guard.would_deny" : "module_host_guard.denied");
+  if (r.refuse) { notFoundHandler(req, res); return; }
+  next();
+}
+
+/** Mounted on /api before the router (req.path is relative to /api, exactly the prefixes the registry lists). */
+export const moduleHostApiGuard: RequestHandler = (req, res, next) => apply("api", currentModuleContext(), req, res, next);
+
+const ASSET_PATH = /\.[a-z0-9]{1,8}$/i;
+/** Page requests on a module's own host: another module's pages are 404 (the SPA shell is not served for them). */
+export const moduleHostPageGuard: RequestHandler = (req, res, next) => {
+  if ((req.method !== "GET" && req.method !== "HEAD") || req.path.startsWith("/api") || isApiHost(req.hostname)) { next(); return; }
+  // Assets (js/css/images) are shared files, not module routes. Judge by Host only: a page load has no Origin.
+  if (ASSET_PATH.test(req.path)) { next(); return; }
+  apply("page", resolveRequestModule(req.hostname), req, res, next);
+};
+
+export const moduleHostHeaders: RequestHandler = (req, res, next) => {
+  if (isModuleHostGuardEnforcing() && resolveRequestModule(req.hostname)) {
+    res.setHeader("Content-Security-Policy", `frame-ancestors ${moduleFrameAncestors()}`);
+    res.setHeader("Referrer-Policy", "no-referrer");
+  }
+  next();
+};
