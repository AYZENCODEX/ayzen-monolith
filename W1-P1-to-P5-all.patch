+  }
+  for (const bad of ["SYL-000000", "SYL-0000001", "SYL-00001", "syl-000001", "SYL000001", "SYL-1", "SYL-01", " SYL-000001", "SYL-000001 ", 5, null, undefined, "AYZEN-0001"]) {
